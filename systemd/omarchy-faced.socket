[Unit]
Description=Face verification socket for unprivileged callers
Documentation=https://github.com/Kalinewb/omarchy-face

[Socket]
ListenStream=/run/omarchy-face/verify.sock
SocketMode=0666
# Reachable by anyone, because the daemon decides from the kernel's peer
# credentials rather than from file permissions: "only about your own account"
# is not something a mode bit can say.
Accept=no

[Install]
WantedBy=sockets.target
