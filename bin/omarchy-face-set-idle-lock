#!/bin/bash

# omarchy:summary=Set how long the session waits before locking
# omarchy:args=<seconds>
# omarchy:hidden=true

# shell.json belongs to the user, so this needs no privilege. It exists as a
# script rather than inline JSON editing in QML because the file is the shell's
# live configuration: a half-written one takes the bar down with it, so it is
# written whole and moved into place.

set -euo pipefail

seconds=${1:-}
[[ $seconds =~ ^[0-9]+$ ]] || {
  echo "usage: omarchy-face-set-idle-lock <seconds>" >&2
  exit 2
}

config=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json
[[ -f $config ]] || {
  echo "no shell.json to update" >&2
  exit 1
}

python3 - "$config" "$seconds" <<'PY'
import json, os, sys, tempfile

path, seconds = sys.argv[1], int(sys.argv[2])
config = json.load(open(path))
idle = config.setdefault("idle", {})
idle["lock"] = seconds

# The screensaver cannot sensibly outlast the lock it precedes.
screensaver = idle.get("screensaver")
if isinstance(screensaver, int) and screensaver >= seconds:
    idle["screensaver"] = max(30, seconds // 2)

directory = os.path.dirname(path)
with tempfile.NamedTemporaryFile("w", dir=directory, delete=False) as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
    temporary = handle.name
os.replace(temporary, path)
print("idle lock set to %ds" % seconds)
PY
