#!/bin/bash

# omarchy:summary=PAM authenticator: exits 0 when the camera sees the named user
# omarchy:hidden=true

# Runs as root from pam_exec on the `sufficient` line. Exit 0 authenticates the
# user; every other exit code, and every unexpected condition, does not. Fail
# closed, always -- a bug in here must cost someone a password prompt, never
# grant a session.
#
# The invariants the gate already checked are re-asserted cheaply, so a stack
# that somehow carries this line without its gate is still safe.

set -u
unset IFS BASH_ENV ENV CDPATH

# Resolved before PATH is pinned, because it becomes part of it. In a real
# install this is /usr/local/bin and adds nothing; running the scripts straight
# out of a checkout, it is what lets the siblings find each other. Either way
# the directory is the one holding a root-owned script PAM already executes.
SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export PATH=$SELF_DIR:/usr/local/bin:/usr/bin
umask 077

CONFIG_DIR=/etc/omarchy-face
CONFIG_FILE=$CONFIG_DIR/config
DISABLED_FILE=$CONFIG_DIR/disabled

config_get() {
  local key=$1 default=${2:-} value
  [[ -r $CONFIG_FILE ]] || {
    printf '%s\n' "$default"
    return
  }
  value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$CONFIG_FILE" 2>/dev/null | tail -1)
  value=${value%%#*}
  value=${value%"${value##*[![:space:]]}"}
  [[ -n $value ]] || value=$default
  printf '%s\n' "$value"
}


# Identifies the authentication attempt, not the moment in time. sudo re-runs
# the whole auth stack for each password retry from the same process, so the
# parent PID is constant across those retries and different for the next
# invocation -- exactly the boundary we want. A PID alone would be unsafe
# (the kernel recycles them), so the process start time goes in the key too:
# a recycled PID has a different start time and its stale marker is ignored.
attempt_key() {
  local stat rest start
  [[ -r /proc/$PPID/stat ]] || return 1
  stat=$(</proc/$PPID/stat) || return 1
  # comm sits in parentheses and may contain spaces, so index from after it.
  rest=${stat#*") "}
  start=$(awk '{print $20}' <<<"$rest")
  [[ -n $start ]] || return 1
  printf '%s\n' "$PPID-$start"
}

ATTEMPTS_DIR=/run/omarchy-face/attempts

user=${PAM_USER:-}
[[ -n $user ]] || exit 1

# A username that is not a username never reaches an engine's argv.
[[ $user =~ ^[a-z_][a-z0-9_-]*\$?$ ]] || exit 1
id -u -- "$user" >/dev/null 2>&1 || exit 1

[[ -e $DISABLED_FILE ]] && exit 1
[[ $user == root && $(config_get allow_root false) != true ]] && exit 1

engine=$(config_get engine howdy)
[[ $engine =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 1

# When this runs from a privileged stack -- sudo, polkit -- it is already root
# and can drive the engine directly. From the lock screen it is not: that stack
# belongs to an ordinary user process, there is nothing for seteuid to elevate
# to, and the face models are unreadable. Ask the daemon, which holds the
# privilege this context never had.
if [[ $EUID -ne 0 ]]; then
  if [[ -S /run/omarchy-face/verify.sock ]]; then
    # python3 rather than socat: the engine already requires it, and a face
    # unlock that fails because a networking swiss-army-knife is missing would
    # be a poor way to find out about a dependency.
    reply=$(OMARCHY_FACE_USER="$user" OMARCHY_FACE_WAIT="${OMARCHY_FACE_TIMEOUT:-10}" \
      /usr/bin/python3 -c '
import os, socket, sys

try:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(float(os.environ.get("OMARCHY_FACE_WAIT", 10)) + 15)
    connection.connect("/run/omarchy-face/verify.sock")
    connection.sendall(("VERIFY %s %s\n" % (
        os.environ["OMARCHY_FACE_USER"],
        os.environ.get("OMARCHY_FACE_WAIT", "10"),
    )).encode())
    sys.stdout.write(connection.recv(128).decode("utf-8", "replace").strip())
except Exception:
    sys.stdout.write("NO unreachable")
' 2>/dev/null)
    [[ $reply == OK* ]] && exit 0
    exit 1
  fi
  # No daemon and no privilege: there is no way to check, and guessing yes is
  # not among the options.
  exit 1
fi

adapter=""
for candidate in "$SELF_DIR/omarchy-face-engine-$engine" "/usr/local/bin/omarchy-face-engine-$engine"; do
  if [[ -x $candidate ]]; then
    adapter=$candidate
    break
  fi
done
[[ -n $adapter ]] || exit 1

# State for any UI that wants to draw this. Notification failures are
# swallowed inside the notifier; the engine's exit code is the only thing that
# decides the outcome, and it is captured before anything else can touch $?.
notify() { omarchy-face-notify "$@" 2>/dev/null || true; }

notify start
"$adapter" verify "$user"
status=$?

if [[ $status -eq 0 ]]; then
  notify matched
  if key=$(attempt_key); then rm -f "$ATTEMPTS_DIR/$key" 2>/dev/null; fi
else
  notify failed "$status"
  # Mark this authentication as having had its turn at the camera. Best effort:
  # if the marker cannot be written the only cost is a second camera attempt.
  if key=$(attempt_key); then
    mkdir -p "$ATTEMPTS_DIR" 2>/dev/null
    chmod 0755 "$ATTEMPTS_DIR" 2>/dev/null
    # Markers outlive their process if PAM is killed mid-stack, so sweep old
    # ones rather than letting them accumulate until reboot.
    find "$ATTEMPTS_DIR" -maxdepth 1 -type f -mmin +10 -delete 2>/dev/null
    : >"$ATTEMPTS_DIR/$key" 2>/dev/null
  fi
fi

exit $status
