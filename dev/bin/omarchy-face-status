#!/bin/bash

# Stub engine: the read half (plan-merged.md §2.2), served from dev/fixtures.
#
# GUI phases are built before the engine that answers them, so the panel needs
# something that speaks the contract without installing anything. This prints a
# fixture and exits 0 -- as the real helper must, always (§2.2) -- and it writes
# nothing anywhere. $OMARCHY_FACE_DEV_FIXTURE picks the fixture directory.

set -uo pipefail

FIXTURES=${OMARCHY_FACE_DEV_FIXTURES:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../fixtures" && pwd)}
FIXTURE=${OMARCHY_FACE_DEV_FIXTURE:-fresh}
FILE="$FIXTURES/$FIXTURE/status.json"

# The build log's tail, from wherever the stand-in job is writing it. Same
# bounds as the real helper: the last 64 KB, carriage returns split, 20 lines.
if [[ ${1:-} == --install-log ]]; then
  LOG=${OMARCHY_FACE_DEV_STATE:-$FIXTURES/$FIXTURE}/install.log
  [[ -r $LOG ]] && tail -c 65536 "$LOG" | tr '\r\000' '\n ' | tail -n 20
  exit 0
fi

if [[ ! -f $FILE ]]; then
  # A missing fixture is a development mistake, not a machine state. Say so in
  # the document itself rather than exiting non-zero, which the GUI would read
  # as the helper being absent.
  printf '{"rows":[{"id":"system","label":"Face'"'"'s system files","state":"unknown","detail":"dev stub: no fixture %s","fixable":false}],"camera":{},"config":{},"engine":{},"install":{},"lock":{},"removal":{}}\n' "$FIXTURE"
  exit 0
fi

# A machine the stub's `purge` has been through. The fixture is a snapshot of one
# state, and the Remove view's second gate clause is about the state AFTER a
# purge: reopening the popup has to find `removal` empty. So the marker the admin
# stub drops turns the same fixture into a purged machine -- the read half's
# answer changing because something was removed, not because a second fixture was
# hand-written to say so.
MARKER=${OMARCHY_FACE_DEV_STATE:-$FIXTURES/$FIXTURE}/purged
if [[ -e $MARKER ]] && command -v jq >/dev/null 2>&1; then
  jq -c '.removal = {people: [], pam: [], lockWrapper: false, helpers: 0,
                     daemon: false, policy: false, packages: []}
         | .config.sudo = false
         | .engine.installed = false
         | .rows = [.rows[] | if .id == "system"
                              then {id: "system", label: "Face'"'"'s system files",
                                    state: "needs_action", detail: "not installed",
                                    fixable: true, fix: "install-first"}
                              else . end]' "$FILE"
  exit 0
fi

cat "$FILE"
exit 0
