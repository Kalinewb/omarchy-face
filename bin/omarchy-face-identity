#!/bin/bash

# omarchy:summary=Check whether a named face is in front of the camera
# omarchy:args=<verify|list> [identity]
# omarchy:hidden=true

# Named identities exist for the question PAM cannot express: not "is this the
# account owner" but "is this a particular other person" -- a profile that
# should open for a partner, say. PAM authenticates a Unix user, and there is
# only one.
#
# This holds no privilege of its own. Everything that needs root lives in
# omarchy-faced, reached over a socket at a fixed absolute path, which means
# there is one rate limit, one session policy, one thing talking to the camera,
# and no root process started with an argv that a caller chose.
#
# It answers yes or no, and lists names. It cannot enrol, delete, or produce an
# encoding; enrolment lives in omarchy-face-admin behind the owner's prompt,
# because deciding who else may open something is the owner's call.
#
# Understand what the no-prompt answer grants: any process running as you can
# ask whether a given enrolled face is present. That is narrower than it
# sounds -- the camera's ACL already lets any such process watch the sensor
# directly -- but it is not nothing, and it must never gate anything that is a
# real security boundary.

set -uo pipefail
export PATH=/usr/local/bin:/usr/bin
unset IFS BASH_ENV ENV CDPATH

SOCKET=/run/omarchy-face/verify.sock

ask() {
  OMARCHY_FACE_REQUEST="$1" /usr/bin/python3 -c '
import os, socket, sys

try:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(45)
    connection.connect("/run/omarchy-face/verify.sock")
    connection.sendall((os.environ["OMARCHY_FACE_REQUEST"] + "\n").encode())
    chunks = []
    while True:
        chunk = connection.recv(4096)
        if not chunk:
            break
        chunks.append(chunk)
    sys.stdout.write(b"".join(chunks).decode("utf-8", "replace"))
except Exception:
    sys.stdout.write("NO unreachable\n")
' 2>/dev/null
}

case ${1:-} in
  verify)
    identity=${2:-}
    [[ $identity =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || exit 1
    [[ -S $SOCKET ]] || exit 1
    # Bounded tighter than PAM's own attempt: something asks this before
    # falling back to the owner, and the owner should not wait out a full
    # camera timeout for a face that is not theirs.
    reply=$(ask "VERIFY-IDENTITY $identity ${OMARCHY_FACE_TIMEOUT:-4}" | head -1)
    [[ $reply == OK* ]] && exit 0
    exit 1
    ;;

  list)
    [[ -S $SOCKET ]] || exit 0
    ask "LIST-IDENTITIES" | sed -n 's/^NAME //p'
    ;;

  *)
    echo "usage: omarchy-face-identity <verify|list> [identity]" >&2
    exit 2
    ;;
esac
