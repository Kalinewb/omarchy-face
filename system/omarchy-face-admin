#!/bin/bash
#
# omarchy-face v2
# omarchy-face-version: 2.0.3
#
# Every privileged thing Face does, behind one polkit action
# (plan-engine.md §8.2, plan-merged.md §2.3).
#
#   pkexec /usr/local/bin/omarchy-face-admin <verb> [args]
#
# Contract, and it is the same for every verb here:
#   one JSON document on stdout, prose on stderr
#   exit 0 ok · 1 {"error":code,…} · 3 busy (store flock or install job)
#   126/127 come from pkexec itself and mean the owner declined
#
# Phase 2 (F1) implements the three verbs that exist before there is a store or
# an engine: install-system, purge and purge-legacy. Phase 3 (F2) adds the two
# that build it: install-engine, which starts the job, and build-engine, which
# is the job. Phase 4 (F3) adds the store verbs, and phase 5 (F4) the two that
# wire sudo: sudo-on and sudo-off, the only verbs here that edit a file PAM
# reads. Phase 7 (F6) adds lock-on and lock-off, which move one setting the
# daemon reads and wire nothing at all: the lock screen wrapper is a plugin
# folder, enabled and disabled without privilege.
#
# WHO MAY RUN THIS. The polkit action is auth_self, so on a machine with more
# than one login *any* active user can authenticate as themselves and get this
# file running as root. That is only safe because of the caller check below:
# the uid pkexec reports must be the account Face was set up for.
#
# install-system is not reachable through that action at all: it only accepts a
# snapshot from a caller that is already root, which is system/install.sh after
# it has checked every file against the pins in its authorised text.

set -uo pipefail
unset IFS BASH_ENV ENV CDPATH
PATH=/usr/local/bin:/usr/bin
umask 022

# Root inherits the caller's working directory -- pkexec keeps it -- and every
# path in this file is absolute, so there is nothing to lose by leaving it. What
# there is to gain: `python3 -c` puts the current directory at the front of
# sys.path, so a `sudo omarchy-face-admin …` run by hand from a directory
# holding a file called json.py or re.py would have root import it. The store
# script is run with `-I` for the same reason; this is the half that also covers
# anything else here that ever shells out.
cd / 2>/dev/null || true

# Every decision in this file is made by matching the output of another program,
# and several of those programs translate. `pacman -Qi`'s "Depends On" is
# "Hängt ab von" under a German locale, and the CUDA check below would have
# quietly matched nothing and kept a CUDA dlib. C also pins `sort -V`, awk's
# number formatting and date's field widths, all of which end up in files other
# code parses.
export LC_ALL=C

CONFIG_DIR=/etc/omarchy-face
CONFIG_FILE=$CONFIG_DIR/config
STORE_DIR=/var/lib/omarchy-face
RUN_DIR=/run/omarchy-face
POLICY=/usr/share/polkit-1/actions/no.graveklar.face.policy
UNIT_DIR=/etc/systemd/system
MODELS=/usr/lib/security/howdy/models
BUILD_STATE=/var/lib/private/omarchy-face-build
INSTALL_UNIT=omarchy-face-install.service
BUILD_PHASE_UNIT=omarchy-face-build.service

ENGINE_FILE=$STORE_DIR/engine.json
PEOPLE_DIR=$STORE_DIR/people
PEOPLE_FILE=$STORE_DIR/people.json
STORE_LOCK=$STORE_DIR/.lock
INSTALL_FILE=$RUN_DIR/install.json
INSTALL_LOG=$RUN_DIR/install.log
INSTALL_LOCK=$RUN_DIR/install.lock
INSTALL_START_LOCK=$RUN_DIR/install-start.lock
HOWDY_DIR=/usr/lib/security/howdy
HOWDY_CONFIG=$HOWDY_DIR/config.ini
HOWDY_DROPIN=/usr/lib/systemd/system/polkit-agent-helper@.service.d/10-howdy.conf
CAMERA=/usr/local/bin/omarchy-face-camera

# The fixed step list of plan-engine.md §5.2. It is in the contract
# (plan-merged.md §2.2 `install.steps`), so the GUI renders it as a checklist
# with elapsed seconds and never as a percentage.
INSTALL_STEPS=(deps fetch build install configure "done")

# What the build needs that a stock Arch machine may not have (§5.2 step 1).
# python-dlib's own library dependencies are deliberately NOT here: `pacman -U`
# resolves a package file's dependencies from the sync databases, so they arrive
# with it and this list stays the one thing it is -- what is needed to *build*.
BUILD_DEPS=(base-devel git python-opencv python-setuptools boost cmake sqlite
            cblas lapack libx11 libinih libevdev v4l-utils)

# The two AUR revisions this release of Face builds from, and the reason they
# are written down rather than taken as "whatever the AUR has today".
#
# A PKGBUILD is a shell script that root ends up running the results of:
# `pacman -U` executes the package's install scriptlet as root, and a package
# may create files nothing of ours owns -- a sudoers drop-in, a polkit rule, a
# PAM module, a unit. Checking the built package's .PKGINFO (which is generated
# FROM the PKGBUILD) cannot catch a PKGBUILD that was changed on purpose; it
# only catches one that drifted honestly. Pinning the revision is what makes the
# thing an owner approves the thing that was reviewed, and makepkg's own
# sha256sums then cover the sources those PKGBUILDs pull in.
#
# When the AUR moves on, the build stops with `pkgbuild_changed` until a Face
# release reads the new PKGBUILD and moves these two lines. That is the point:
# a new howdy revision is a change to what runs as root on this machine.
#
#   python-dlib 20.0.1-2   howdy 2.6.1-3   (read and built 2026-09-14)
AUR_PIN_PYTHON_DLIB=84910843274aa2989f0ebb3cba3347ba7c78f6b8
AUR_PIN_HOWDY=ef1ec20b7eb7c0cdc40d371bdb0e0ef6c8641bce

# The installed set (plan-engine.md §8.1). Source name : destination : mode.
# One table, used by install, by the version check and by purge, so the three
# can never disagree about what "the system half" is.
SYSTEM_FILES=(
  "omarchy-face-admin:/usr/local/bin/omarchy-face-admin:0755"
  "omarchy-face-gate:/usr/local/bin/omarchy-face-gate:0755"
  "omarchy-face-verify:/usr/local/bin/omarchy-face-verify:0755"
  "omarchy-faced:/usr/local/bin/omarchy-faced:0755"
  "omarchy-face-identity:/usr/local/bin/omarchy-face-identity:0755"
  "omarchy-face-lock-verify:/usr/local/bin/omarchy-face-lock-verify:0755"
  "omarchy-face-camera:/usr/local/bin/omarchy-face-camera:0755"
  "omarchy-faced.socket:$UNIT_DIR/omarchy-faced.socket:0644"
  "omarchy-faced.service:$UNIT_DIR/omarchy-faced.service:0644"
  "no.graveklar.face.policy:$POLICY:0644"
)

# --- output ------------------------------------------------------------------

# JSON by hand. This file runs as root from a polkit action; giving it a runtime
# dependency on jq would mean a missing package turns every verb into a parse
# error in the GUI.
json_string() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/ }
  value=$(printf '%s' "$value" | tr -d '\000-\037')
  printf '"%s"' "$value"
}

json_array() {
  local first=1 item
  printf '['
  for item in "$@"; do
    ((first)) || printf ','
    first=0
    json_string "$item"
  done
  printf ']'
}

audit() {
  logger -t omarchy-face -p auth.notice -- "$*" 2>/dev/null || true
}

die() { # die <code> [exit status]
  printf '{"error":%s}\n' "$(json_string "$1")"
  exit "${2:-1}"
}

# --- config ------------------------------------------------------------------

# Read with sed, never sourced: /etc/omarchy-face/config is root-owned, but
# `source`ing a key=value file is a habit that stops being safe the moment
# somebody adds a path to it (plan-engine.md §4.2).
config_get() {
  local key=$1 default=${2:-} value
  [[ -r $CONFIG_FILE ]] || { printf '%s' "$default"; return; }
  value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$CONFIG_FILE" 2>/dev/null | tail -1)
  value=${value%%#*}
  value=${value%"${value##*[![:space:]]}"}
  [[ -n $value ]] || value=$default
  printf '%s' "$value"
}

# --- the caller --------------------------------------------------------------

[[ $EUID -eq 0 ]] || die "not_root"

verb=${1:-}
[[ -n $verb ]] || die "no_verb"
shift

# PKEXEC_UID is set by pkexec and cannot be forged by the caller: it is the uid
# polkit authenticated. Absent means we were started by something that was
# already root (the install script, a systemd unit, a root shell), which can do
# everything here anyway -- there is no privilege to protect in that direction.
#
# Present means the auth_self dialog just handed root to whoever answered it, so
# it has to be the one account Face manages. A second login on this machine
# authenticating as themselves gets `not_owner`, not root.
caller_uid=${PKEXEC_UID:-}
account=$(config_get account)

assert_owner() {
  [[ -n $caller_uid ]] || return 0
  [[ -n $account ]] || die "not_installed"
  local account_uid
  account_uid=$(id -u -- "$account" 2>/dev/null) || die "unknown_account"
  [[ $caller_uid == "$account_uid" ]] || die "not_owner"
}

# --- who counts as an administrator ------------------------------------------
#
# The polkit action is auth_self, so the dialog takes the INVOKING account's own
# password. PKEXEC_UID is who invoked pkexec, not who authenticated, and nothing
# about either says that account is an administrator.
#
# That matters for exactly one verb. `install-system` installs scripts out of
# the account's own plugin folder into /usr/local/bin, and from phase 5 those
# scripts run as root from sudo's PAM stack. If Face could be set up for an
# ordinary user, that user could edit their own plugin folder, run
# `pkexec omarchy-face-admin install-system` with their OWN password, and be
# root -- and the version check is no obstacle at all, because a `-dev` version
# is exempt by design and the header sits in the same writable file.
#
# So: Face's owner is by construction an administrator. install-system then
# grants nothing that the owner's password does not already grant. Every other
# verb stays auth_self on purpose -- people, permissions, sudo wiring and purge
# are the owner's own decisions about their own machine.
admin_group() {
  # polkit's administrator identity, read rather than assumed. Arch's
  # 50-default.rules says `unix-group:wheel`; a machine that says something else
  # is honoured, and an unparseable file falls back to wheel.
  local group
  group=$(sed -n 's/.*unix-group:\([a-zA-Z0-9_.-]\+\).*/\1/p' \
    /usr/share/polkit-1/rules.d/50-default.rules 2>/dev/null | head -1)
  printf '%s' "${group:-wheel}"
}

assert_account_is_admin() { # assert_account_is_admin <account>
  local who=$1 group
  group=$(admin_group)
  id -Gn -- "$who" 2>/dev/null | tr ' ' '\n' | grep -qxF "$group" || die "not_admin"
}

# Removal has to work on a machine whose config is already gone -- a purge that
# was interrupted after step 3, or a half-finished install. With no config there
# is no account to be the owner of, and nothing left that is worth refusing to
# take away.
assert_owner_unless_uninstalled() {
  [[ -n $account ]] || return 0
  assert_owner
}

# --- shared install machinery ------------------------------------------------

snapshot_dir=""
cleanup_snapshot() {
  [[ -n $snapshot_dir && -d $snapshot_dir ]] && rm -rf -- "$snapshot_dir"
  snapshot_dir=""
}
trap cleanup_snapshot EXIT

# Set by install-system from the snapshot install.sh verified. Every function
# below that can `die` sets a global instead of printing its answer, because a
# $(…) around one of them runs it in a subshell: `die` would exit that
# subshell, its JSON would land in the variable being assigned, and the caller
# would carry on with an error document where it expected a path.

# Everything in the snapshot must be a plain file. `cp -a --no-dereference`
# copies a symlink AS a symlink, so a link in the plugin folder arrives here as
# a link and would have been followed out of the snapshot when it was installed
# -- back into the folder we just stopped trusting, or anywhere else.
#
# `-links +1` catches two names in the snapshot that are the same inode (cp -a
# preserves links within one copy). It does NOT prove the source was not a hard
# link to something outside, and it does not need to: each file was copied to a
# fresh inode that nothing outside this directory can reach.
verify_snapshot_shape() {
  local tmp=$1 bad
  bad=$(find "$tmp" -mindepth 1 \( -type l -o -links +1 -o ! -type f \) -print -quit 2>/dev/null)
  [[ -z $bad ]] || die "snapshot_unsafe"
}

file_version() {
  # The version header, from the top of the file only. `#` in a script and two
  # spaces inside the policy's XML comment, hence the loose prefix.
  head -40 "$1" 2>/dev/null |
    sed -n 's/^[^[:alnum:]]*omarchy-face-version:[[:space:]]*\([0-9A-Za-z.+-]*\).*/\1/p' | head -1
}

has_v2_marker() {
  head -40 "$1" 2>/dev/null | grep -q 'omarchy-face v2'
}

# One version for the whole set: the files are installed together and compared
# together, so a snapshot whose parts disagree is a broken release, not a state
# to install and then puzzle over.
# Sets $new_version.
snapshot_version() {
  local tmp=$1 entry source version first=""
  for entry in "${SYSTEM_FILES[@]}"; do
    source=$tmp/${entry%%:*}
    [[ -f $source ]] || die "snapshot_incomplete"
    has_v2_marker "$source" || die "snapshot_unmarked"
    version=$(file_version "$source")
    [[ -n $version ]] || die "snapshot_unversioned"
    [[ -n $first ]] || first=$version
    [[ $version == "$first" ]] || die "snapshot_mixed_versions"
  done
  new_version=$first
}

installed_version() {
  local entry dest version first=""
  for entry in "${SYSTEM_FILES[@]}"; do
    dest=${entry#*:}; dest=${dest%:*}
    [[ -f $dest ]] || { printf ''; return 1; }
    version=$(file_version "$dest")
    [[ -n $version ]] || { printf ''; return 1; }
    [[ -n $first ]] || first=$version
    [[ $version == "$first" ]] || { printf ''; return 1; }
  done
  printf '%s' "$first"
}

# `diff -q`, not `cmp -r`: cmp has no recursive mode at all, and diff's exit
# codes (0 same, 1 different, 2 error) are the three answers this needs.
snapshot_differs() {
  local tmp=$1 entry source dest
  for entry in "${SYSTEM_FILES[@]}"; do
    source=$tmp/${entry%%:*}
    dest=${entry#*:}; dest=${dest%:*}
    diff -q "$source" "$dest" >/dev/null 2>&1 || return 0
  done
  return 1
}

version_is_dev() { [[ $1 == *-dev ]]; }

# Is $1 strictly newer than $2, in semver order?
#
# `sort -V` alone is NOT that order, whatever the comment that used to sit
# here said: it puts `2.0.0-dev` AFTER `2.0.0`, where semver puts a
# pre-release before the release it leads to. Mapping the first `-` to `~`
# gives semver's rule exactly, because sort -V does treat `~` as sorting
# before everything -- the Debian convention it borrows. It changes the
# ordering of a pre-release against its own release and of nothing else.
#
# It was wrong on the one day it mattered: the release that ends a
# development cycle read as OLDER than the -dev build it replaced, so
# `install-system` refused the upgrade as a downgrade and the Setup row
# offered no Fix for a machine one button press from correct.
version_newer() { # version_newer <a> <b>
  local a=${1/-/\~} b=${2/-/\~}
  [[ $a != "$b" ]] || return 1
  [[ $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -1) == "$a" ]]
}

# A directory root helpers are installed into must be root-owned and writable by
# nobody else. /usr/local/bin with a group write bit is a way to replace a file
# that PAM runs as root, and it is worth one stat to refuse rather than to
# assume the distribution got it right.
assert_dir_safe() { # assert_dir_safe <dir>
  local info mode
  info=$(stat -Lc '%u %a' "$1" 2>/dev/null) || die "install_dir_unsafe"
  [[ ${info%% *} == 0 ]] || die "install_dir_unsafe"
  mode=${info##* }
  (( (8#$mode & 8#022) == 0 )) || die "install_dir_unsafe"
}

# The same question about one file: root-owned, nobody else writable. What §4.1
# calls assert_helper_safe, and what pam_insert_block asks before it points an
# auth stack at a helper.
file_is_safe() { # file_is_safe <path>
  local info mode
  info=$(stat -Lc '%u %a' "$1" 2>/dev/null) || return 1
  [[ ${info%% *} == 0 ]] || return 1
  mode=${info##* }
  (( (8#$mode & 8#022) == 0 ))
}

# Fills the global `changed`. Not a subshell and not a pipeline on purpose: a
# `die` inside a $(…) would exit that subshell and print its JSON into the
# caller's variable, and the install would carry on as though nothing had gone
# wrong.
changed=()
install_from_snapshot() { # install_from_snapshot <snapshot dir>
  local tmp=$1 entry source dest mode dir
  changed=()
  for entry in "${SYSTEM_FILES[@]}"; do
    source=$tmp/${entry%%:*}
    dest=${entry#*:}; dest=${dest%:*}
    mode=${entry##*:}
    dir=$(dirname -- "$dest")
    [[ -d $dir ]] || install -d -o root -g root -m 0755 "$dir" || die "install_failed"
    assert_dir_safe "$dir"
    if ! diff -q "$source" "$dest" >/dev/null 2>&1; then
      changed+=("${entry%%:*}")
    fi
    # Install beside it, then rename. install(1) does NOT replace atomically --
    # it unlinks, creates, writes and chmods as separate steps, so for the width
    # of a write there is a file at that path with the wrong length and the
    # wrong mode. These are files PAM runs as root; rename(2) is one step, and
    # a process that already has one open keeps the inode it opened.
    install -o root -g root -m "$mode" "$source" "$dest.tmp" || die "install_failed"
    mv -f "$dest.tmp" "$dest" || { rm -f "$dest.tmp"; die "install_failed"; }
  done
}

# Appends to the global $warnings. systemd is not always reachable -- an install
# inside a container, or a machine mid-boot -- and a socket that could not be
# enabled is a warning to carry in the document, not a reason to leave the files
# half installed.
warnings=()
systemctl_step() { # systemctl_step <args…>
  systemctl "$@" >/dev/null 2>&1 || warnings+=("systemctl $* failed")
}

# --- the PAM stack, in one place ---------------------------------------------
#
# Two functions, written together because they are each other's mirror:
# `purge` removes the block, and phase 5's `sudo-on`/`sudo-off` insert and
# remove the same block from the same file (§4.1). Two implementations of an
# edit to an auth stack is how the two stop agreeing about what a safe edit is,
# and the file they disagree about is the one that decides whether anybody can
# become root on this machine.
#
# The rules both obey:
#
#   * one flock for the whole operation, so two roots editing at once is not a
#     state that has to be reasoned about;
#   * copy the file FIRST and compute every count, line number and check from
#     the copy -- reading the live file six times and then editing from those
#     numbers is a race a concurrent writer can win;
#   * refuse anything that is not exactly the shape we wrote;
#   * verify the result before it is renamed into place, including that the
#     stack's own invariant line survived.

PAM_DIR=/etc/pam.d
PAM_LOCK=/run/omarchy-face-pam.lock
PAM_BEGIN='# omarchy-face begin'
PAM_END='# omarchy-face end'
PAM_GATE_LINE='auth  [success=1 default=ignore]  pam_exec.so seteuid quiet /usr/local/bin/omarchy-face-gate'
PAM_VERIFY_LINE='auth  sufficient                  pam_exec.so seteuid quiet /usr/local/bin/omarchy-face-verify'
# The ONLY lines the marked block may contain. A line somebody added inside it
# is not ours to delete, so a block holding one is refused, not cleaned.
PAM_BLOCK_LINE='^auth[[:space:]]+.*[[:space:]]pam_exec\.so[[:space:]].*/usr/local/bin/omarchy-face-(gate|verify)$'
# What must still be true of the stack afterwards, when it was true before
# (§4.1). Not "must be present": Face does not get to decide that every PAM
# file in the world includes system-auth, only that it did not remove it.
PAM_INVARIANT='^auth[[:space:]]+include[[:space:]]+system-auth'

pam_lock() {
  [[ -e $PAM_LOCK ]] || (umask 077; : >"$PAM_LOCK") 2>/dev/null
  exec 9>>"$PAM_LOCK" 2>/dev/null || return 1
  flock -w 10 9
}

# Remove Face's marked block from one PAM stack.
#   0  removed
#   2  nothing of ours is in it -- the file is not touched, not even copied
#   1  refused: not the shape we wrote. The caller reports it; the file is
#      exactly as it was.
pam_remove_block() { # pam_remove_block <file>
  local file=$1 copy begin end n_begin n_end block_lines before after had_invariant line
  [[ -f $file ]] || return 2
  grep -q "^${PAM_BEGIN}\$" "$file" 2>/dev/null || return 2
  pam_lock || return 1

  copy=$(mktemp "$(dirname -- "$file")/.omarchy-face.XXXXXX") || return 1
  # cp -p carries mode, owner and timestamps, so the file that is renamed into
  # place is the original in every respect but the four lines.
  cp -p "$file" "$copy" 2>/dev/null || { rm -f "$copy"; return 1; }

  n_begin=$(grep -c "^${PAM_BEGIN}\$" "$copy")
  n_end=$(grep -c "^${PAM_END}\$" "$copy")
  begin=$(grep -n "^${PAM_BEGIN}\$" "$copy" | head -1 | cut -d: -f1)
  end=$(grep -n "^${PAM_END}\$" "$copy" | head -1 | cut -d: -f1)
  # A begin with no end would make a range delete run to the END OF FILE. On an
  # auth stack that is not a bad edit, it is a machine nobody can authenticate
  # to -- and "no omarchy-face line left" cannot tell the difference, because a
  # file whose tail is gone has none either.
  if [[ $n_begin != 1 || $n_end != 1 || -z $begin || -z $end || $begin -ge $end ]]; then
    rm -f "$copy"
    return 1
  fi

  while IFS= read -r line; do
    [[ $line =~ $PAM_BLOCK_LINE ]] || { rm -f "$copy"; return 1; }
  done < <(sed -n "$((begin + 1)),$((end - 1))p" "$copy")

  had_invariant=false
  grep -qE "$PAM_INVARIANT" "$copy" && had_invariant=true
  block_lines=$((end - begin + 1))
  before=$(wc -l <"$copy")

  sed -i "${begin},${end}d" "$copy"

  after=$(wc -l <"$copy")
  if [[ $after != $((before - block_lines)) ]] || grep -q 'omarchy-face' "$copy"; then
    rm -f "$copy"
    return 1
  fi
  if [[ $had_invariant == true ]] && ! grep -qE "$PAM_INVARIANT" "$copy"; then
    rm -f "$copy"
    return 1
  fi
  mv -f "$copy" "$file" || { rm -f "$copy"; return 1; }
  audit "removed the face block from $file"
  return 0
}

# Is this file already carrying exactly the block we write, and nothing else of
# ours? Strictly: one begin, one end, in that order, and between them the two
# lines verbatim.
#   0  yes -- the stack is already wired, and correctly
#   1  no  -- either nothing of ours, or something that is not what we write
#
# It is the question `sudo-on` asks before it inserts, so that a machine whose
# config and stack disagree (the `sudo` row's `broken` state) can be repaired by
# the same button that turns the feature on, rather than needing an off-then-on
# that would refuse in the middle.
pam_block_intact() { # pam_block_intact <file>
  local file=$1 begin end n_begin n_end body
  [[ -f $file ]] || return 1
  n_begin=$(grep -c "^${PAM_BEGIN}\$" "$file" 2>/dev/null) || return 1
  n_end=$(grep -c "^${PAM_END}\$" "$file" 2>/dev/null) || return 1
  [[ $n_begin == 1 && $n_end == 1 ]] || return 1
  begin=$(grep -n "^${PAM_BEGIN}\$" "$file" | head -1 | cut -d: -f1)
  end=$(grep -n "^${PAM_END}\$" "$file" | head -1 | cut -d: -f1)
  [[ -n $begin && -n $end && $begin -lt $end ]] || return 1
  # Exactly four lines of ours, nowhere else in the file.
  [[ $(grep -c 'omarchy-face' "$file") == 4 ]] || return 1
  body=$(sed -n "$((begin + 1)),$((end - 1))p" "$file")
  [[ $body == "$PAM_GATE_LINE"$'\n'"$PAM_VERIFY_LINE" ]] || return 1
  # And an auth line of somebody else's has to FOLLOW it. `success=1` is a jump
  # over the next line in the stack; if the block is the last thing in it, the
  # gate's skip jumps past the end -- and a jump past the end of an auth chain is
  # not "carry on to the password", it is a failure after one. Only root can move
  # the block there, and the check costs one grep: `sudo-on` is not allowed to
  # call such a file "already wired" and leave it.
  tail -n +"$((end + 1))" "$file" | grep -qE '^[[:space:]]*auth[[:space:]]' || return 1
  return 0
}

# Insert Face's block above the first auth line of one PAM stack (§4.1).
#   0  inserted
#   1  refused -- including when the helpers it would point at are not root's
#
# **Phase 5 (F4) is the only caller**: `sudo-on`, on /etc/pam.d/sudo. It is
# written here rather than there so that the insert and the removal share their
# invariants, their lock and their idea of what the block looks like.
pam_insert_block() { # pam_insert_block <file>
  local file=$1 copy new first_auth before after original helper
  [[ -f $file ]] || return 1

  # Nothing points an auth stack at a helper that somebody else can write
  # (§4.1, the old assert_helper_safe).
  for helper in /usr/local/bin/omarchy-face-gate /usr/local/bin/omarchy-face-verify; do
    file_is_safe "$helper" || return 1
  done

  # Not "no block": no mention of Face at all. A leftover line outside a block
  # is exactly the state a second insert would make unreadable.
  grep -q 'omarchy-face' "$file" 2>/dev/null && return 1
  pam_lock || return 1

  copy=$(mktemp "$(dirname -- "$file")/.omarchy-face.XXXXXX") || return 1
  cp -p "$file" "$copy" 2>/dev/null || { rm -f "$copy"; return 1; }
  new=$copy.new

  first_auth=$(grep -n '^auth' "$copy" | head -1 | cut -d: -f1)
  [[ -n $first_auth ]] || { rm -f "$copy"; return 1; }
  before=$(wc -l <"$copy")
  original=$(cat "$copy")

  {
    head -n $((first_auth - 1)) "$copy"
    printf '%s\n' "$PAM_BEGIN" "$PAM_GATE_LINE" "$PAM_VERIFY_LINE" "$PAM_END"
    tail -n +"$first_auth" "$copy"
  } >"$new" 2>/dev/null || { rm -f "$copy" "$new"; return 1; }

  after=$(wc -l <"$new")
  # Four lines more, one block, and -- the check that makes the other two worth
  # having -- the file with our lines taken back out is what we started from.
  if [[ $after != $((before + 4)) ]] ||
     [[ $(grep -c "^${PAM_BEGIN}\$" "$new") != 1 ]] ||
     [[ $(grep -c "^${PAM_END}\$" "$new") != 1 ]] ||
     [[ $(grep -v 'omarchy-face' "$new") != "$original" ]]; then
    rm -f "$copy" "$new"
    return 1
  fi
  if grep -qE "$PAM_INVARIANT" "$copy" && ! grep -qE "$PAM_INVARIANT" "$new"; then
    rm -f "$copy" "$new"
    return 1
  fi

  chmod --reference="$copy" "$new" 2>/dev/null
  chown --reference="$copy" "$new" 2>/dev/null
  mv -f "$new" "$file" || { rm -f "$copy" "$new"; return 1; }
  rm -f "$copy"
  audit "inserted the face block into $file"
  return 0
}

# --- the engine build job (F2) -----------------------------------------------
#
# Two verbs, and the split between them is the whole point of this phase.
#
#   install-engine   starts a transient root unit and returns immediately
#   build-engine     is what that unit runs
#
# `install-engine` is pkexec'd, so it is a child of the popup's Process and dies
# with it. The build takes tens of minutes, so it must not be that child: it is
# started with `systemd-run --unit=omarchy-face-install`, which puts it in its
# own cgroup under PID 1. Closing the popup, restarting the shell or logging out
# does not touch it, and nothing is lost when they happen -- the job's whole
# state is /run/omarchy-face/install.json and install.log, both world-readable,
# so a GUI that comes back simply reads where the build got to.
#
# That is also why a second click cannot start a second build: `install-engine`
# asks systemd whether the unit is active and exits 3 if it is.

install_started=0
install_step=""
install_notes=()

now_seconds() { date +%s; }

ensure_run_dir() {
  [[ -d $RUN_DIR ]] || install -d -o root -g root -m 0755 "$RUN_DIR" 2>/dev/null
}

# A lock file, created 0600 BEFORE anything opens it. `exec 8>>path` creates it
# at the umask -- 0644 -- and chmodding afterwards leaves a window in which any
# local process can open it; flock(2) needs no write access, so one that got in
# during that window could hold LOCK_EX for ever and leave every later build
# saying "the engine is already building" until the next boot. /run is root's,
# so this is a small window on a small surface, and it costs one line to not
# have it. (The same shape as pam_lock above.)
open_lock() { # open_lock <fd> <path>
  local fd=$1 path=$2
  [[ -e $path ]] || (umask 077; : >"$path") 2>/dev/null
  chmod 0600 "$path" 2>/dev/null
  eval "exec $fd>>\"\$path\"" 2>/dev/null
}

# install.json is the contract's `install` object (plan-merged.md §2.2), written
# by same-directory temp + rename (§2 rule 5) so a reader never sees half a
# document. 0644: the GUI runs as the owner and has to be able to read it.
write_install() { # write_install <state> <step> <error>
  local state=$1 step=$2 error=$3 now tmp
  now=$(now_seconds)
  ((install_started)) || install_started=$now
  ensure_run_dir
  tmp=$INSTALL_FILE.tmp
  printf '{"state":%s,"step":%s,"steps":%s,"startedAt":%s,"updatedAt":%s,"error":%s,"notes":%s}\n' \
    "$(json_string "$state")" "$(json_string "$step")" \
    "$(json_array "${INSTALL_STEPS[@]}")" "$install_started" "$now" \
    "$(json_string "$error")" \
    "$(json_array ${install_notes[@]+"${install_notes[@]}"})" >"$tmp" 2>/dev/null || return 1
  chmod 0644 "$tmp" 2>/dev/null
  mv -f "$tmp" "$INSTALL_FILE" 2>/dev/null
}

# The job outlives the process that asked for it, so `startedAt` has to outlive
# it too: install-engine writes the first document, build-engine continues it.
# Elapsed time in the GUI is measured from that first write, which is when the
# owner clicked -- not from when systemd got round to the unit.
read_install_started() {
  local value
  value=$(sed -n 's/.*"startedAt":\([0-9]\{1,\}\).*/\1/p' "$INSTALL_FILE" 2>/dev/null | head -1)
  [[ $value =~ ^[0-9]+$ ]] && install_started=$value
}

install_log() { # install_log <line…>
  ensure_run_dir
  printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >>"$INSTALL_LOG" 2>/dev/null
}

# Is the engine already installed, and installed the way this phase installs it?
# "howdy is present" is not enough: a python-dlib built with CUDA satisfies
# `pacman -Q` and is exactly what E9 says not to have on this machine, so a
# machine carrying one is rebuilt rather than kept.
engine_packages_cpu_only() {
  pacman -Q howdy >/dev/null 2>&1 || return 1
  pacman -Q python-dlib >/dev/null 2>&1 || return 1
  pacman -Q python-dlib-cuda >/dev/null 2>&1 && return 1
  pacman -Qi python-dlib 2>/dev/null | sed -n 's/^Depends On[[:space:]]*:[[:space:]]*//p' |
    grep -qi 'cuda' && return 1
  engine_python_matches || return 1
  return 0
}

# A python-dlib built for a Python that is no longer /usr/bin/python3 is
# installed and CPU-only and still cannot be imported: a minor Python upgrade
# leaves it in the old /usr/lib/pythonX.Y/site-packages, which the new
# interpreter never looks in. Without this the `engine` row's "build the engine
# again" Fix skipped every step but `configure` and the row stayed broken.
#
# The same comparison omarchy-face-status makes (its `python_built` /
# `python_running`), kept in step with it by hand: that file runs as the user
# from the plugin folder, and this one is not going to source it. And the same
# rule: an answer it cannot read -- two site-packages, no link -- is not a
# mismatch.
engine_python_matches() {
  local built running
  built=$(pacman -Qlq python-dlib 2>/dev/null |
    sed -n 's#^/usr/lib/python\([0-9][0-9]*\.[0-9][0-9]*\)/site-packages/.*#\1#p' | sort -u)
  running=$(readlink -f /usr/bin/python3 2>/dev/null |
    sed -n 's#^.*/python\([0-9][0-9]*\.[0-9][0-9]*\)$#\1#p')
  [[ $built =~ ^[0-9]+\.[0-9]+$ && $running =~ ^[0-9]+\.[0-9]+$ ]] || return 0
  [[ $built == "$running" ]]
}

# Start the job. 0 started · 3 one is already running · 1 systemd would not.
job_error=""
start_install_job() {
  job_error=""
  ensure_run_dir
  [[ -d $RUN_DIR ]] || { job_error=install_failed; return 1; }

  # Serialise the whole start, not just the check. Two clicks can both pass
  # `is-active` before either systemd-run has run; the fixed unit name still
  # stops a second build, but the loser would go on to truncate the winner's
  # log, reset its startedAt and then write `failed`/`start_failed` over a build
  # that is running perfectly well -- a false failure with a Try again button on
  # it, for however long the winner takes to reach its next step.
  #
  # A lock of its own, NOT the job's: build-engine takes install.lock in its own
  # process, and it may well do so while this one is still returning.
  open_lock 7 "$INSTALL_START_LOCK" || { job_error=install_failed; return 1; }
  flock -w 10 7 || { job_error=install_running; return 3; }

  if systemctl is-active --quiet "$INSTALL_UNIT" 2>/dev/null; then
    job_error=install_running
    return 3
  fi

  # --collect reaps the unit when it finishes, but a machine that lost systemd's
  # collection (a manager restart mid-build) can be left with a failed unit of
  # that name, and `systemd-run --unit=` refuses a name that already exists.
  systemctl reset-failed "$INSTALL_UNIT" >/dev/null 2>&1

  # One log per build. The last build's output is not worth keeping: the GUI
  # shows a tail of the CURRENT build, and a log that grows across attempts
  # would show the previous failure at the bottom of a successful one.
  : >"$INSTALL_LOG" 2>/dev/null
  chmod 0644 "$INSTALL_LOG" 2>/dev/null
  install_started=0
  install_notes=()
  write_install running "" ""
  install_log "starting the engine build"

  # Type=exec, so this call fails when the helper cannot be executed rather than
  # returning success for a unit that dies a moment later: `{"started":true}` has
  # to mean it started. RuntimeMaxSec bounds a build that hangs -- systemd kills
  # it, the TERM trap in build-engine writes `failed`, and the row stops saying
  # "building" for ever.
  if ! systemd-run --unit=omarchy-face-install --collect --quiet \
       --property=Type=exec \
       --property=RuntimeMaxSec=7200 \
       --property=Description="omarchy-face engine build" \
       --setenv="OMARCHY_FACE_REQUESTER=${caller_uid:-0}" \
       /usr/local/bin/omarchy-face-admin build-engine >>"$INSTALL_LOG" 2>&1; then
    write_install failed "" start_failed
    job_error=start_failed
    return 1
  fi
  audit "engine build started by uid ${caller_uid:-0}"
  return 0
}

# --- what the build user runs -------------------------------------------------
#
# makepkg is run neither by root nor by the invoking user (plan-engine.md §5.2
# step 3). It runs under `systemd-run -p DynamicUser=yes -p
# StateDirectory=omarchy-face-build`, which is a uid systemd allocates for the
# duration and nothing else on the machine can be: no process running as the
# owner can write into the directory the packages are built in, so the package
# file root is about to install cannot be swapped between `makepkg` and
# `pacman -U`.
#
# The script is passed as argv rather than installed as a file, because the file
# would have to join the `system` row's fixed set of ten (§8.1) to be compared
# and installed with the rest, and it is only ever run by the lines below.
#
# **What this split does and does not protect against.** It stops a process
# running as the owner from swapping the package file between `makepkg` and
# `pacman -U`, because that directory is not theirs to write. It is NOT a
# boundary against a bad PKGBUILD: `pacman -U` runs a package's install
# scriptlet as root, and a package can create files Face does not own, so
# whatever these PKGBUILDs say ends up trusted as much as this script is. That
# is why the revisions are pinned above and why root still reads the built
# packages back before installing them -- the pin decides *which* PKGBUILD runs,
# and the verification catches a build that came out wrong (CUDA, the polkit
# drop-in) rather than one that was written to lie.
read -r -d '' BUILD_SCRIPT <<'BUILD_SCRIPT_END' || true
set -uo pipefail
umask 022
export PATH=/usr/bin

dir=$1
phase=$2
pin_dlib=${3:-}
pin_howdy=${4:-}
cd "$dir" || { printf 'no_build_dir\n' >"$dir/result" 2>/dev/null; exit 1; }

# One word, read by root. The exit status says "something went wrong"; this says
# which thing, and survives systemd-run losing the status to a signal.
fail() { printf '%s\n' "$1" >"$dir/result"; exit 1; }
note() { printf '%s\n' "$1" >>"$dir/notes"; }

: >"$dir/result"

# Clone one AUR package AT a revision, not at whatever the AUR has today. A
# shallow clone gives HEAD; when HEAD is not the pin, the AUR does serve an
# explicit object (`fetch --depth 1 origin <sha>`), and anything that leaves the
# checkout somewhere else stops the build.
clone_pinned() { # clone_pinned <url> <dir> <sha>
  local url=$1 target=$2 sha=$3
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || fail pkgbuild_changed
  git clone --depth 1 "$url" "$target" || fail fetch_failed
  if [[ $(git -C "$target" rev-parse HEAD 2>/dev/null) != "$sha" ]]; then
    git -C "$target" fetch --depth 1 origin "$sha" || fail pkgbuild_changed
    git -C "$target" checkout --quiet --detach "$sha" || fail pkgbuild_changed
  fi
  [[ $(git -C "$target" rev-parse HEAD 2>/dev/null) == "$sha" ]] || fail pkgbuild_changed
  printf '%s %s\n' "${target##*/}" "$sha" >>"$dir/revisions"
}

case $phase in
  fetch)
    rm -rf -- "$dir/python-dlib" "$dir/howdy" "$dir/notes" "$dir/revisions"
    clone_pinned https://aur.archlinux.org/python-dlib.git "$dir/python-dlib" "$pin_dlib"
    clone_pinned https://aur.archlinux.org/howdy.git "$dir/howdy" "$pin_howdy"
    ;;

  build)
    # Still the revisions that were fetched. The two phases are two runs, and
    # the patches below are only meaningful against the PKGBUILD that was
    # pinned, not against whatever is in the directory now.
    [[ $(git -C "$dir/python-dlib" rev-parse HEAD 2>/dev/null) == "$pin_dlib" ]] || fail pkgbuild_changed
    [[ $(git -C "$dir/howdy" rev-parse HEAD 2>/dev/null) == "$pin_howdy" ]] || fail pkgbuild_changed

    # dlib's PKGBUILD defaults to building the CUDA package as well (E9). If the
    # flag is not where it was, stop: silently pulling ~2.7 GB of CUDA from a
    # GUI click is the wrong failure.
    grep -q '^_build_cuda=1$' "$dir/python-dlib/PKGBUILD" || fail cuda_flag_missing
    sed -i 's/^_build_cuda=1$/_build_cuda=0/' "$dir/python-dlib/PKGBUILD" || fail cuda_flag_missing
    grep -q '^_build_cuda=0$' "$dir/python-dlib/PKGBUILD" || fail cuda_flag_missing

    # howdy's package() installs a systemd drop-in that widens the polkit agent
    # helper's device access. Face is never in polkit-1, so it buys nothing and
    # is dropped. The install line is a two-line continuation, hence awk rather
    # than sed. An absent anchor is a note, not a failure -- root checks the
    # built package either way.
    if grep -q 'polkit-agent-helper-howdy\.conf' "$dir/howdy/PKGBUILD"; then
      awk '
        skip { if ($0 !~ /\\$/) skip = 0; next }
        /install .*polkit-agent-helper-howdy\.conf/ { if ($0 ~ /\\$/) skip = 1; next }
        { print }
      ' "$dir/howdy/PKGBUILD" >"$dir/howdy/PKGBUILD.patched" || fail polkit_patch_failed
      mv -f "$dir/howdy/PKGBUILD.patched" "$dir/howdy/PKGBUILD" || fail polkit_patch_failed
      if grep -q '10-howdy\.conf' "$dir/howdy/PKGBUILD"; then fail polkit_patch_failed; fi
    else
      note "howdy's PKGBUILD no longer names the polkit drop-in"
    fi

    # --nodeps: root installed everything the build needs in the deps step, and
    # makepkg's own dependency handling would want to call pacman as a user that
    # deliberately cannot.
    ( cd "$dir/python-dlib" && makepkg -f --noconfirm --nodeps ) || fail dlib_build_failed
    ( cd "$dir/howdy" && makepkg -f --noconfirm --nodeps ) || fail howdy_build_failed
    ;;

  *)
    fail bad_phase
    ;;
esac
exit 0
BUILD_SCRIPT_END

# The phase runs in a unit of its own, and that unit is NOT in this process's
# cgroup -- so if the job is stopped (RuntimeMaxSec, `systemctl stop`), a
# twenty-minute makepkg would otherwise carry on with nothing left watching it.
# BindsTo ties the two together: the build stops when the job does.
#
# It can only be added when this process really IS the job. A BindsTo on a unit
# systemd cannot load refuses to start at all, so a root-by-hand run must not
# carry one -- and `is-active` is the wrong question for that, because it is
# also true for a *different* process watching the same job. $INVOCATION_ID is
# set by systemd for the service it starts, and comparing it with the unit's own
# invocation id answers exactly "am I that unit". A systemctl that will not
# answer while we are inside a unit is not something to shrug at: the build we
# are about to start would be one nothing can stop.
# Sets $build_binding.
build_binding=()
compute_build_binding() {
  build_binding=()
  # $INVOCATION_ID alone proves nothing: systemd exports it into a service and
  # every descendant inherits it, terminals included. It is only the cheap way
  # to skip the question when there is obviously no unit.
  [[ -n ${INVOCATION_ID:-} ]] || return 0
  # And there is nothing to ask when systemd is not running at all (a container,
  # a chroot, this project's test namespace). That is not a machine where a
  # build can be left unstoppable, because there is no manager to lose it to.
  [[ -d /run/systemd/system ]] || return 0
  local id
  # A systemctl that will not answer while we are inside a unit IS worth
  # stopping for: the build we are about to start would be one nothing can stop.
  id=$(systemctl show -p InvocationID --value "$INSTALL_UNIT" 2>/dev/null) ||
    build_fail systemd_unreachable
  # Empty, or somebody else's: we are not that unit, so there is nothing to bind
  # to and a BindsTo would only stop this from starting.
  [[ -n $id && $id == "$INVOCATION_ID" ]] || return 0
  build_binding=(--property="BindsTo=$INSTALL_UNIT" --property="After=$INSTALL_UNIT")
}

run_as_builder() { # run_as_builder <fetch|build>
  systemctl reset-failed "$BUILD_PHASE_UNIT" >/dev/null 2>&1
  systemd-run --wait --pipe --quiet --collect --unit="${BUILD_PHASE_UNIT%.service}" \
    --property=DynamicUser=yes \
    --property=StateDirectory=omarchy-face-build \
    --property=WorkingDirectory=/var/lib/omarchy-face-build \
    --property=Description="omarchy-face engine build ($1)" \
    ${build_binding[@]+"${build_binding[@]}"} \
    --setenv=HOME=/var/lib/omarchy-face-build \
    --setenv=LANG=C \
    --setenv=LC_ALL=C \
    /bin/bash -c "$BUILD_SCRIPT" omarchy-face-build /var/lib/omarchy-face-build "$1" \
    "$AUR_PIN_PYTHON_DLIB" "$AUR_PIN_HOWDY" \
    >>"$INSTALL_LOG" 2>&1
}

# Files the build user wrote, read by root. Both go through this: `-f` alone
# follows a symlink, so a link left at one of these names would have root read
# whatever it points at and put a filtered copy of it into the world-readable
# install.json. Nothing should be able to plant one -- the directory is the
# dynamic user's -- but root reading a name it did not create is exactly the
# habit that stops being harmless later.
builder_file_safe() { # builder_file_safe <path>
  [[ -f $1 && ! -L $1 ]]
}

# The word the build user left behind, if any. `tr -cd` because this file is
# written by a uid that is not root's and is about to become an error code in a
# JSON document.
builder_result() {
  builder_file_safe "$BUILD_STATE/result" || return 0
  head -1 "$BUILD_STATE/result" 2>/dev/null | tr -cd 'a-z_'
}

# One phase as the build user, and two ways to hear that it failed. systemd-run
# --wait propagates the service's exit status, but a service killed by a signal
# has no status to propagate -- and a phase that wrote `result` and then died
# still knows more about what went wrong than "it exited non-zero" does.
run_builder_phase() { # run_builder_phase <fetch|build>
  local code
  if ! run_as_builder "$1"; then
    code=$(builder_result)
    build_fail "${code:-build_user_failed}"
  fi
  code=$(builder_result)
  [[ -z $code ]] || build_fail "$code"
  collect_builder_notes
}

collect_builder_notes() {
  local line
  builder_file_safe "$BUILD_STATE/notes" || return 0
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    install_notes+=("$(printf '%s' "$line" | tr -cd '\040-\176' | cut -c1-120)")
  done <"$BUILD_STATE/notes"
  rm -f -- "$BUILD_STATE/notes"
}

# Exactly one package file of that name, or nothing. `<name>-[0-9]*` and not
# `<name>-*`, so python-dlib-cuda-20.0.1-… is never mistaken for python-dlib's
# own package -- which is the one mistake in this file that would install CUDA.
found_package=""
find_package() { # find_package <dir> <pkgname>
  local dir=$1 name=$2 file matches=()
  found_package=""
  for file in "$dir/$name"-[0-9]*.pkg.tar.*; do
    [[ -f $file ]] || continue
    [[ $file == *.sig ]] && continue
    matches+=("$file")
  done
  ((${#matches[@]} == 1)) || return 1
  found_package=${matches[0]}
}

package_info() { # package_info <file>
  bsdtar -xOqf "$1" .PKGINFO 2>/dev/null
}

build_dir_remove() {
  rm -rf -- "$BUILD_STATE" 2>/dev/null
  # systemd leaves /var/lib/<name> as a symlink into private/ for a DynamicUser
  # unit. Removing the target without the link leaves a dangling name behind.
  [[ -L /var/lib/omarchy-face-build ]] && rm -f -- /var/lib/omarchy-face-build
  return 0
}

build_fail() { # build_fail <code>
  local code=$1
  install_log "FAILED at ${install_step:-start}: $code"
  write_install failed "$install_step" "$code"
  audit "engine build failed at ${install_step:-start}: $code"
  build_dir_remove
  printf '{"error":%s}\n' "$(json_string "$code")"
  exit 1
}

# systemd stopping the unit (RuntimeMaxSec, `systemctl stop`, shutdown) must not
# leave install.json saying `running` for ever: the GUI would show a build that
# is not happening and offer no way back. A SIGKILL cannot be caught, which is
# why omarchy-face-status also treats `running` with no active unit as a build
# that stopped (§10.1's install-job row).
build_interrupted() {
  install_log "the build was stopped"
  # Whatever the build user is doing, it is not wanted any more. (BindsTo in
  # run_as_builder covers the case where systemd stops the job itself; this
  # covers a signal that reached this process alone.)
  systemctl stop "$BUILD_PHASE_UNIT" >/dev/null 2>&1
  write_install failed "$install_step" interrupted
  build_dir_remove
  exit 143
}

step_begin() { # step_begin <step>
  install_step=$1
  write_install running "$1" ""
  install_log "== $1"
}

# One value out of a flat JSON document (omarchy-face-camera's --describe). Not
# a JSON parser and not trying to be: jq is a build dependency of nothing here,
# and this file has to work on a machine where the install has not finished.
json_value() { # json_value <document> <key>
  local doc=$1 key=$2
  printf '%s' "$doc" | sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

config_ini_get() { # config_ini_get <key>
  local value
  value=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$HOWDY_CONFIG" 2>/dev/null | head -1)
  # Trailing whitespace is not part of the value; howdy's parser ignores it and
  # the read-back check below would not.
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

# One anchored edit, then read it back. A key that is not in the file is
# `config_key_missing` rather than a line appended to the end: howdy's config is
# sectioned, and a key appended after [debug] is a key in the wrong section that
# howdy silently ignores (plan-engine.md §5.2 step 5).
set_config_key() { # set_config_key <key> <value>
  local key=$1 value=$2 escaped
  grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$HOWDY_CONFIG" 2>/dev/null || return 1
  # The value is a device path: it carries slashes, and sed would read them as
  # the end of the replacement. Backslash and & are sed's own too.
  escaped=${value//\\/\\\\}
  escaped=${escaped//&/\\&}
  escaped=${escaped//\//\\/}
  sed -i "s/^[[:space:]]*${key}[[:space:]]*=.*/${key} = ${escaped}/" "$HOWDY_CONFIG" 2>/dev/null || return 1
  # The package installs this tree 0600 and it stays that way: the config holds
  # the camera the authentication runs against, and nothing unprivileged has any
  # business reading it (which is what engine.json is for).
  chmod 0600 "$HOWDY_CONFIG" 2>/dev/null
  [[ $(config_ini_get "$key") == "$value" ]]
}

# --- the people store (F3) ----------------------------------------------------
#
# Everything about people lives in one embedded Python program. Three reasons,
# and none of them is taste:
#
#   * a record holds 128-float encodings. Validating "exactly 128 numbers" and
#     writing them back byte-for-byte is not something bash can be trusted with,
#     and `regenerate` has to be idempotent to the byte (§3.6 test 1);
#   * the derived files are howdy's own model format -- JSON -- and the enrol
#     session reads one back out of a file howdy wrote;
#   * `enroll-session` is a long-lived JSON-line conversation on stdin, which in
#     bash would be a read loop parsing JSON with sed.
#
# python3 is not a new dependency: the engine *is* python (howdy's cli.py and
# compare.py are what capture runs), so any machine where a face can be recorded
# has it. The verbs that run before the engine exists -- install-system, purge,
# purge-legacy, the build -- do not touch this code, so a machine without python
# can still install and remove Face.
#
# The script is passed as argv (python3 -c), like the build script above, for the
# same reason: a second file would have to join the `system` row's fixed set of
# ten to be compared and installed with the rest.
read -r -d '' STORE_PY <<'STORE_PY_END' || true
import errno
import fcntl
import glob
import json
import os
import re
import secrets
import select
import subprocess
import sys
import time

STORE_DIR = "/var/lib/omarchy-face"
PEOPLE_DIR = STORE_DIR + "/people"
PEOPLE_FILE = STORE_DIR + "/people.json"
LOCK_FILE = STORE_DIR + "/.lock"
ENGINE_FILE = STORE_DIR + "/engine.json"
RUN_DIR = "/run/omarchy-face"
CAMERA_LOCK = RUN_DIR + "/camera.lock"
CONFIG_FILE = "/etc/omarchy-face/config"
HOWDY_DIR = "/usr/lib/security/howdy"
HOWDY_CONFIG = HOWDY_DIR + "/config.ini"
MODELS = HOWDY_DIR + "/models"

# The two rules the GUI is told about in people.json and the engine enforces
# here (plan-engine.md §3.2). The name is the Profiles contract key, so it is a
# slug with no room for argument; the label is anything printable a person wants
# to be called, within one line.
NAME_RULE = r"^[a-z][a-z0-9-]{0,23}$"
LABEL_RULE = r"^[^\x00-\x1f\x7f]{1,32}$"

MAX_APPEARANCES = 3
# Not in the plan, which only names the error code `person_limit`. A bound there
# has to be, because every person's appearances end up in a set compare.py walks
# per frame and in a world-readable summary; 16 people is more than the
# household this is for and small enough that the sudo set stays a list somebody
# could read. It is never reached by the GUI, which offers no bulk import.
MAX_PEOPLE = 16

# The three appearance labels the GUI offers; they are not enforced here (any
# label within LABEL_RULE is accepted) and exist only so the standard ones are
# spelled the same way everywhere.
STANDARD_APPEARANCES = ["No glasses", "Everyday glasses", "Reading glasses"]

# howdy's stock `certainty`, in the contract's 0-1 scale (plan-merged.md §2
# rule 8). Only used when neither howdy's config nor engine.json can be read,
# which is a machine where nothing can be captured anyway.
FALLBACK_THRESHOLD = 0.35
WEAK_MARGIN = 0.05

# How long a capture may take. `add` loops up to 60 frames after a 2 s pause and
# has no timeout of its own; `compare.py` has its own (config `timeout`, 5 s),
# and the ceiling here is the backstop for a V4L call stuck in the kernel
# (plan-merged.md §2 rule 9 -- every compare.py runs under `timeout -k 2`).
ADD_SECONDS = 40
COMPARE_SECONDS = 8
CAMERA_LOCK_WAIT = 5.0
STORE_LOCK_WAIT = 5.0

# How long a session may stand still, and how long it may last at all
# (plan-engine.md §12 risk 9).
#
# A session is a standing authorisation: one password opens it, and every
# capture and the commit inside it are unprompted. A root process blocked in a
# read on stdin for ever is therefore an open way to add a face -- including to
# a person with Sudo -- for whoever walks up to an unlocked machine. So the read
# has a deadline: no command for IDLE_SECONDS, or SESSION_SECONDS from `ready`
# whatever happens, and the session discards. **Never a commit**: an expiry
# writes nothing, exactly like the EOF cancel it is treated as.
#
# IDLE_SECONDS is longer than anything the GUI does between commands (the card's
# own idle bound is shorter, so in normal use the card closes first and says
# why), and long enough that a person reading the card is not cut off.
IDLE_SECONDS = 120
SESSION_SECONDS = 300
# A command line is a small JSON object. Anything past this is not a protocol
# this file speaks, and buffering it would be a way to make root allocate.
MAX_LINE = 65536

# Debris from a session that was killed between taking a frame and committing
# (plan-engine.md §3.3).
ENROLL_DEBRIS_AGE = 600


class Fatal(Exception):
    """Ends the verb with {"error":code,…} and exit 1."""

    def __init__(self, code, **extra):
        Exception.__init__(self, code)
        self.code = code
        self.extra = extra


class Busy(Exception):
    """Exit 3: somebody else holds the store lock (plan-merged.md §2 rule 3)."""


def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def prose(text):
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


def audit(text):
    """The journal line for a store change. Names only, never labels: people.json
    is world-readable but the journal is a different audience, and a name is what
    every other record of this (PAM, the daemon) is keyed on."""
    try:
        subprocess.run(["logger", "-t", "omarchy-face", "-p", "auth.notice", "--", text],
                       env={"PATH": "/usr/local/bin:/usr/bin"},
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except OSError:
        pass


def config_get(key, default=""):
    try:
        with open(CONFIG_FILE, "r") as handle:
            for line in handle:
                match = re.match(r"^\s*" + re.escape(key) + r"\s*=\s*(.*?)\s*$", line)
                if match:
                    return match.group(1).split("#")[0].strip()
    except OSError:
        pass
    return default


def account():
    who = config_get("account")
    if not who:
        raise Fatal("not_installed")
    return who


# --- atomic writes ------------------------------------------------------------
#
# Same directory, temp + rename (plan-merged.md §2 rule 5), and the mode is set
# on the temp file before it is renamed: a world-readable summary that exists for
# a moment as 0600 is harmless, but a 0600 record that exists for a moment as
# 0644 is an encoding somebody could have read.

def write_file(path, text, mode):
    directory = os.path.dirname(path)
    tmp = os.path.join(directory, ".omarchy-face.%s.tmp" % secrets.token_hex(6))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.chmod(tmp, mode)
        os.chown(tmp, 0, 0)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_json(path, doc, mode):
    write_file(path, json.dumps(doc, separators=(",", ":")) + "\n", mode)


def ensure_dirs():
    for path, mode in ((STORE_DIR, 0o755), (PEOPLE_DIR, 0o700)):
        if not os.path.isdir(path):
            os.makedirs(path, mode)
        os.chmod(path, mode)
        os.chown(path, 0, 0)


class store_lock(object):
    """The store flock (plan-engine.md §3.2). Held only while writing."""

    def __enter__(self):
        ensure_dirs()
        if not os.path.exists(LOCK_FILE):
            os.close(os.open(LOCK_FILE, os.O_WRONLY | os.O_CREAT, 0o600))
        os.chmod(LOCK_FILE, 0o600)
        self.fd = os.open(LOCK_FILE, os.O_WRONLY | os.O_APPEND)
        deadline = time.time() + STORE_LOCK_WAIT
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.time() >= deadline:
                    os.close(self.fd)
                    raise Busy()
                time.sleep(0.1)

    def __exit__(self, *exc):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        return False


# --- records ------------------------------------------------------------------

def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def rule_ok(rule, value):
    """A rule of §3.2, applied the way the GUI applies it.

    `re.match(r"…$", x)` is NOT that: in python `$` also matches just before a
    trailing newline, so `re.match(LABEL_RULE, "Anna\\n")` succeeds and a label
    with a line break in it would be accepted by the engine and refused by the
    GUI. fullmatch has to consume the whole string, newline included."""
    return isinstance(value, str) and re.fullmatch(rule, value) is not None


def validate_record(path, doc):
    """Every rule of plan-engine.md §3.2, or store_corrupt naming the file."""

    def bad():
        raise Fatal("store_corrupt", file=path)

    if not isinstance(doc, dict):
        bad()
    name = doc.get("name")
    if not rule_ok(NAME_RULE, name):
        bad()
    # The file name is the key the rest of the store is indexed by; a record
    # that says it is somebody else would make `regenerate` write a derived set
    # under one name from a record stored under another.
    if os.path.basename(path) != name + ".json":
        bad()
    if not rule_ok(LABEL_RULE, doc.get("label")):
        bad()
    for key in ("owner", "sudo", "lock"):
        if not isinstance(doc.get(key), bool):
            bad()
    if not is_number(doc.get("created")):
        bad()
    appearances = doc.get("appearances")
    if not isinstance(appearances, list) or len(appearances) > MAX_APPEARANCES:
        bad()
    seen = set()
    for appearance in appearances:
        if not isinstance(appearance, dict):
            bad()
        label = appearance.get("label")
        if not rule_ok(LABEL_RULE, label):
            bad()
        if label in seen:
            bad()
        seen.add(label)
        if not is_number(appearance.get("time")):
            bad()
        encoding = appearance.get("encoding")
        if not isinstance(encoding, list) or len(encoding) != 128:
            bad()
        for value in encoding:
            if not is_number(value):
                bad()
    return doc


def read_all():
    """Every record, validated, sorted by name. store_corrupt if any is wrong."""
    people = []
    for path in sorted(glob.glob(PEOPLE_DIR + "/*.json")):
        try:
            with open(path, "r") as handle:
                doc = json.load(handle)
        except (OSError, ValueError):
            raise Fatal("store_corrupt", file=path)
        people.append(validate_record(path, doc))
    owners = [p for p in people if p["owner"]]
    if len(owners) > 1:
        raise Fatal("store_corrupt", file=PEOPLE_DIR)
    people.sort(key=lambda p: p["name"])
    return people


def record_path(name):
    return PEOPLE_DIR + "/" + name + ".json"


def find(people, name):
    for person in people:
        if person["name"] == name:
            return person
    return None


def public(person):
    """What leaves this file: never an encoding (plan-engine.md §3.2)."""
    return {
        "name": person["name"],
        "label": person["label"],
        "owner": person["owner"],
        "sudo": person["sudo"],
        "lock": person["lock"],
        "appearances": [{"label": a["label"], "time": a["time"]}
                        for a in person["appearances"]],
    }


def order_for_display(people):
    # Owner first, then by label (plan-gui.md §5.1). people.json is written in
    # this order so the GUI renders it without sorting, and so two regenerates
    # of the same store produce the same bytes.
    return sorted(people, key=lambda p: (0 if p["owner"] else 1, p["label"].lower(), p["name"]))


# --- derivation (plan-engine.md §3.3) -----------------------------------------

def set_path(kind, who):
    return "%s/omarchy-face.%s.%s.dat" % (MODELS, kind, who)


def person_path(name):
    return "%s/omarchy-face.person.%s.dat" % (MODELS, name)


def model_entries(people, key):
    entries = []
    for person in people:
        if key is not None and not person[key]:
            continue
        for appearance in person["appearances"]:
            entries.append({
                "time": appearance["time"],
                "label": person["name"] + "/" + appearance["label"],
                "id": len(entries),
                "data": [appearance["encoding"]],
            })
    return entries


def write_set(path, entries):
    # An empty set is DELETED, never written empty: compare.py exits 10 on a
    # missing file, and 10 on a file holding no models -- but a present file is
    # also a file the sudo row would count as a set that exists.
    if not entries:
        if os.path.exists(path):
            os.unlink(path)
        return
    write_json(path, entries, 0o600)


def warning_for(sudo_faces):
    # From the F3 measurement (plan-engine.md §7): the cost of more Sudo faces
    # is not search time, it is that each template is another chance of landing
    # inside the threshold. Null while sudo_faces <= 3.
    if sudo_faces <= 3:
        return None
    return ("Sudo now matches against %d faces. Every extra face is another "
            "chance that the wrong one is accepted." % sudo_faces)


def newest_time(people):
    # `updated` is the newest thing in the store, not "now". That is what makes
    # regenerate a function of people/*.json alone: run it twice and the bytes
    # are identical, which is §3.6 test 1 and the only way the GUI can tell a
    # real change from a rewrite.
    newest = 0
    for person in people:
        newest = max(newest, int(person["created"]))
        for appearance in person["appearances"]:
            newest = max(newest, int(appearance["time"]))
    return newest


def regenerate(people=None):
    """Rebuild every derived file from people/*.json alone. Caller holds the lock."""
    if people is None:
        people = read_all()
    # At most one owner, asked of the list that is about to be WRITTEN and not
    # only of what read_all() returned. Every other caller hands in a list it
    # has just changed -- a commit added to it, a removal taken out -- and a
    # second owner in one of those is a store that read_all() refuses from the
    # next verb onwards, after the derived sets have already been rebuilt from
    # it (plan-engine.md §3.1: the owner is set once and never moved).
    if len([person for person in people if person.get("owner")]) > 1:
        raise Fatal("store_corrupt", file=PEOPLE_DIR)
    who = account()
    if not os.path.isdir(MODELS):
        # howdy's own directory. Without it there is nothing to derive into, and
        # creating it would be Face inventing half an engine.
        raise Fatal("engine_missing")

    ordered = order_for_display(people)
    sudo_entries = model_entries(people, "sudo")
    lock_entries = model_entries(people, "lock")

    write_set(set_path("sudo", who), sudo_entries)
    write_set(set_path("lock", who), lock_entries)
    for person in people:
        write_set(person_path(person["name"]), model_entries([person], None))

    # A derived file with no record behind it is a face that can still
    # authenticate somebody the store has forgotten.
    for path in glob.glob(MODELS + "/omarchy-face.person.*.dat"):
        name = os.path.basename(path)[len("omarchy-face.person."):-len(".dat")]
        if not os.path.exists(record_path(name)):
            os.unlink(path)
    now = time.time()
    for path in glob.glob(MODELS + "/omarchy-face.enroll.*"):
        try:
            if now - os.path.getmtime(path) > ENROLL_DEBRIS_AGE:
                os.unlink(path)
        except OSError:
            pass

    summary = {
        "people": [public(p) for p in ordered],
        "sudo_faces": len(sudo_entries),
        "lock_faces": len(lock_entries),
        "maxAppearances": MAX_APPEARANCES,
        "nameRule": NAME_RULE,
        "labelRule": LABEL_RULE,
        "appearanceLabels": STANDARD_APPEARANCES,
        "warning": warning_for(len(sudo_entries)),
        "updated": newest_time(people),
    }
    write_json(PEOPLE_FILE, summary, 0o644)
    return summary


# --- the camera ---------------------------------------------------------------

def howdy_threshold():
    """howdy's certainty, on the contract's 0-1 scale (plan-merged.md §2 rule 8)."""
    raw = None
    try:
        with open(HOWDY_CONFIG, "r") as handle:
            for line in handle:
                match = re.match(r"^\s*certainty\s*=\s*([0-9.]+)\s*$", line)
                if match:
                    raw = float(match.group(1))
    except (OSError, ValueError):
        raw = None
    if raw is not None:
        return raw / 10.0
    try:
        with open(ENGINE_FILE, "r") as handle:
            value = json.load(handle).get("threshold")
        if is_number(value):
            return float(value)
    except (OSError, ValueError):
        pass
    return FALLBACK_THRESHOLD


class camera_lock(object):
    """One camera user at a time (plan-engine.md §3.2). Raises Busy on timeout."""

    def __enter__(self):
        if not os.path.isdir(RUN_DIR):
            os.makedirs(RUN_DIR, 0o755)
        if not os.path.exists(CAMERA_LOCK):
            os.close(os.open(CAMERA_LOCK, os.O_WRONLY | os.O_CREAT, 0o600))
        os.chmod(CAMERA_LOCK, 0o600)
        self.fd = os.open(CAMERA_LOCK, os.O_WRONLY | os.O_APPEND)
        deadline = time.time() + CAMERA_LOCK_WAIT
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.time() >= deadline:
                    os.close(self.fd)
                    raise Busy()
                time.sleep(0.2)

    def __exit__(self, *exc):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)
        return False


def engine_env():
    # howdy's cli.py refuses to run without SUDO_USER and refuses to work on the
    # user "root" (cli.py:83-90), so the temp model name is the user and
    # SUDO_USER is only there to get past the check. A fixed environment for the
    # same reason the helper pins its own PATH.
    return {
        "PATH": "/usr/local/bin:/usr/bin",
        "HOME": "/root",
        "LC_ALL": "C",
        "SUDO_USER": "root",
        "PYTHONDONTWRITEBYTECODE": "1",
    }


def run_engine(argv, seconds):
    """One engine call under `timeout -k 2` (plan-merged.md §2 rule 9)."""
    command = ["timeout", "-k", "2", str(seconds)] + argv
    try:
        # howdy writes the temp model itself, with its own idea of a mode. The
        # directory is 0700 root's, so nothing local can read what lands there
        # -- but that is the AUR package's chmod, not ours, and a face is being
        # written for the few seconds between `add` and the unlink. One umask
        # costs nothing and does not depend on somebody else's packaging.
        done = subprocess.run(command, env=engine_env(), stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              preexec_fn=lambda: os.umask(0o077))
    except OSError:
        return 127, ""
    return done.returncode, done.stdout.decode("utf-8", "replace")


# add.py's four ways of failing, by the lines it prints (add.py:166-179). Order
# matters: "All frames were too dark" is followed by an average, and the black
# frame message is the more specific of the two.
ADD_FAILURES = [
    ("Camera saw only black frames", "black_frames"),
    ("All frames were too dark", "too_dark"),
    ("Multiple faces detected", "multiple_faces"),
    ("No face detected", "no_face"),
]


def capture(appearance, threshold):
    """One frame, verified, as an event of plan-merged.md §2.4."""
    nonce = secrets.token_hex(8)
    model = "omarchy-face.enroll." + nonce
    temp = MODELS + "/" + model + ".dat"

    def cleanup():
        try:
            os.unlink(temp)
        except OSError:
            pass

    try:
        with camera_lock():
            code, output = run_engine(
                ["python3", HOWDY_DIR + "/cli.py", "-U", model, "-y", "add"], ADD_SECONDS)
            if code != 0:
                cleanup()
                for needle, mapped in ADD_FAILURES:
                    if needle in output:
                        return {"event": "capture_failed", "code": mapped}
                prose("howdy add exited %d: %s" % (code, output.strip()[-400:]))
                return {"event": "capture_failed", "code": "timeout"}

            # Verified with howdy's own comparison, against the model just
            # written and nothing else: the certainty in the event is the engine's
            # own opinion of the face it just stored, not a number Face invented.
            code, output = run_engine(
                ["python3", HOWDY_DIR + "/compare.py", model], COMPARE_SECONDS)
    except Busy:
        cleanup()
        return {"event": "capture_failed", "code": "camera_busy"}

    if code != 0:
        cleanup()
        prose("compare exited %d: %s" % (code, output.strip()[-400:]))
        # 11 and 13 are compare.py's timeouts; 10 and 12 mean it could not read
        # the model we just wrote, which is an engine that cannot see the face
        # it stored -- retryable either way, and never a reason to keep it.
        return {"event": "capture_failed", "code": "timeout"}

    certainty = None
    for line in output.splitlines():
        match = re.match(r"^Certainty of winning frame:\s*([0-9.]+)", line)
        if match:
            # compare.py:277 prints match * 10; every number in the contract is
            # on howdy's 0-1 distance scale (plan-merged.md §2 rule 8). The
            # pattern admits "1.2.3", which float() does not: this is output
            # being parsed, so it is caught rather than trusted.
            try:
                certainty = float(match.group(1)) / 10.0
            except ValueError:
                certainty = None
        # E8: the winning model's label is the attribution the sudo journal
        # line and the indicator are built on, and it is only correct because
        # each model file here holds exactly one encoding.
        if line.startswith("Winning model:"):
            prose(line.strip())
    if certainty is None:
        cleanup()
        prose("compare printed no certainty; is end_report on?")
        return {"event": "capture_failed", "code": "timeout"}

    try:
        # O_NOFOLLOW: this is root reading a file another program just wrote, by
        # a name root chose. Nothing unprivileged can write howdy's model
        # directory, so a link at that name should be impossible -- which is
        # exactly the sort of "impossible" worth one flag to refuse.
        fd = os.open(temp, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "r") as handle:
            models = json.load(handle)
        encoding = models[0]["data"][0]
    except (OSError, ValueError, IndexError, KeyError, TypeError):
        cleanup()
        return {"event": "capture_failed", "code": "no_face"}
    cleanup()
    # 128 of them AND all numbers: this is JSON another program wrote, and a
    # string or a null in there would be caught by validate_record at the commit
    # (store_corrupt, session-fatal) rather than here, where it is one retryable
    # capture that found nothing usable.
    if not isinstance(encoding, list) or len(encoding) != 128 or \
       not all(is_number(value) for value in encoding):
        return {"event": "capture_failed", "code": "no_face"}

    return {
        "event": "captured",
        "appearance": appearance,
        "certainty": certainty,
        "threshold": threshold,
        "weak": (threshold - certainty) < WEAK_MARGIN,
        "encoding": encoding,
    }


# --- verbs --------------------------------------------------------------------

def check_name(name):
    if not rule_ok(NAME_RULE, name):
        raise Fatal("invalid_name")
    return name


def check_label(label):
    if not rule_ok(LABEL_RULE, label):
        raise Fatal("invalid_label")
    return label


def stdin_json():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except ValueError:
        raise Fatal("bad_input")


def cmd_regenerate():
    with store_lock():
        summary = regenerate()
    emit({"ok": True, "sudo_faces": summary["sudo_faces"],
          "lock_faces": summary["lock_faces"]})


def cmd_set_label(name, payload):
    label = check_label(payload.get("label"))
    with store_lock():
        people = read_all()
        person = find(people, name)
        if person is None:
            raise Fatal("no_person")
        person["label"] = label
        write_json(record_path(name), person, 0o600)
        summary = regenerate(people)
    emit({"ok": True, "person": public(person), "sudo_faces": summary["sudo_faces"]})


def cmd_set_permission(name, which, value):
    if which not in ("sudo", "lock"):
        raise Fatal("bad_arguments")
    with store_lock():
        people = read_all()
        person = find(people, name)
        if person is None:
            raise Fatal("no_person")
        if value and not person["appearances"]:
            raise Fatal("no_appearances")
        person[which] = value
        write_json(record_path(name), person, 0o600)
        summary = regenerate(people)
    emit({"ok": True, "person": public(person), "sudo_faces": summary["sudo_faces"]})


def cmd_remove_appearance(name, payload):
    label = check_label(payload.get("appearance"))
    with store_lock():
        people = read_all()
        person = find(people, name)
        if person is None:
            raise Fatal("no_person")
        kept = [a for a in person["appearances"] if a["label"] != label]
        if len(kept) == len(person["appearances"]):
            raise Fatal("no_appearance")
        person["appearances"] = kept
        # A person with no appearances left holds no permission either: the sets
        # are derived from appearances, so leaving `sudo` true would be a flag
        # with nothing behind it that silently rewires on the next capture.
        if not kept:
            person["sudo"] = False
            person["lock"] = False
        write_json(record_path(name), person, 0o600)
        summary = regenerate(people)
    emit({"ok": True, "person": public(person), "sudo_faces": summary["sudo_faces"]})


def cmd_remove_person(name):
    with store_lock():
        people = read_all()
        person = find(people, name)
        if person is None:
            raise Fatal("no_person")
        # plan-merged.md §1 row 7. The GUI hides the control; this is what makes
        # it true, because IPC and the helper itself can both be called directly.
        if person["owner"]:
            raise Fatal("is_owner")
        people = [p for p in people if p["name"] != name]
        # The derived sets are rebuilt BEFORE the record goes, so a derivation
        # that fails leaves the person intact rather than leaving their
        # encodings in the sudo and lock sets with no record behind them -- a
        # face that can still authenticate somebody the store has forgotten.
        #
        # Moved aside rather than deleted, because regenerate's orphan sweep
        # decides what to delete by asking whether the record is there: with the
        # record still in place it would keep this person's own derived file.
        removed_path = record_path(name) + ".removing"
        os.rename(record_path(name), removed_path)
        try:
            summary = regenerate(people)
        except BaseException:
            os.rename(removed_path, record_path(name))
            raise
        os.unlink(removed_path)
    emit({"ok": True, "removed": name, "sudo_faces": summary["sudo_faces"]})


def session_bounds():
    """The two deadlines, with a test override that can only make them SHORTER.

    dev/f3-people-store.sh has to watch a session expire, and a gate that takes
    two minutes to reach its first assertion is a gate nobody runs. Clamped
    downwards on purpose: an environment variable that could LENGTHEN a standing
    authorisation would be the very thing these deadlines bound. (It cannot
    arrive through the GUI either -- pkexec drops the caller's environment.)"""
    idle, whole = float(IDLE_SECONDS), float(SESSION_SECONDS)
    try:
        asked = float(os.environ.get("OMARCHY_FACE_SESSION_SECONDS", ""))
    except ValueError:
        return idle, whole
    if asked > 0:
        return min(idle, asked), min(whole, asked)
    return idle, whole


class line_reader(object):
    """stdin, one line at a time, with a deadline.

    Not `sys.stdin.readline()`: that blocks until a line arrives, for ever, and
    for this verb "for ever" is how long one password keeps authorising captures
    (plan-engine.md §12 risk 9). A buffered readline cannot be given a deadline
    at all -- select() on the file object would answer "nothing to read" with a
    whole line sitting in python's own buffer -- so the buffering is here."""

    def __init__(self, fd):
        self.fd = fd
        self.buffer = b""
        self.eof = False

    def line(self, deadline):
        """The next line · "" at EOF · None when the deadline passed.

        The newline is kept, so the answers mean what readline's do: an empty
        string is end of input and never a blank line somebody sent."""
        while True:
            cut = self.buffer.find(b"\n")
            if cut >= 0:
                line = self.buffer[:cut + 1]
                self.buffer = self.buffer[cut + 1:]
                return line.decode("utf-8", "replace")
            if self.eof:
                line, self.buffer = self.buffer, b""
                return line.decode("utf-8", "replace") if line else ""
            if len(self.buffer) > MAX_LINE:
                raise Fatal("bad_input")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            # A second at a time, so a clock that jumps or a signal that
            # interrupts the wait costs a second rather than the whole deadline.
            try:
                ready = select.select([self.fd], [], [], min(remaining, 1.0))[0]
            except (OSError, ValueError):
                self.eof = True
                continue
            if not ready:
                continue
            try:
                chunk = os.read(self.fd, 4096)
            except OSError:
                chunk = b""
            if chunk:
                self.buffer += chunk
            else:
                self.eof = True


def cmd_enroll_session(name):
    """plan-merged.md §2.4. JSON lines both ways; stdin EOF is the cancel."""
    # invalid_name is checked first, so it can arrive before `ready` (§2.4).
    check_name(name)
    people = read_all()
    person = find(people, name)
    if person is None and len(people) >= MAX_PEOPLE:
        raise Fatal("person_limit")
    threshold = howdy_threshold()

    emit({"event": "ready", "person": public(person) if person else None})

    created = None          # the record a `create` proposed, not yet written
    captured = {}           # appearance label -> appearance, this session only
    committed = False

    # The two bounds on a standing authorisation (risk 9). `idle_until` is
    # pushed out after every command, including a capture that took its whole
    # forty seconds, so the clock measures a person who has gone away rather
    # than an engine that is busy.
    reader = line_reader(sys.stdin.fileno())
    idle_seconds, whole_seconds = session_bounds()
    idle_until = time.monotonic() + idle_seconds
    ends_at = time.monotonic() + whole_seconds

    while True:
        line = reader.line(min(idle_until, ends_at))
        if line is None:
            # Expired. Treated exactly as the EOF cancel is -- `discarded`,
            # nothing written -- even with captures in hand: a session nobody is
            # driving must never commit a face on its own (§2.4).
            reason = "idle" if time.monotonic() >= idle_until else "the session limit"
            prose("the session expired (%s); nothing was written" % reason)
            audit("enroll-session for %s expired (%s) with %d uncommitted capture(s)"
                  % (name, reason, len(captured)))
            break
        if line == "":
            break
        line = line.strip()
        if line == "":
            continue
        try:
            message = json.loads(line)
        except ValueError:
            prose("ignoring a line that is not JSON")
            continue
        if not isinstance(message, dict):
            continue
        command = message.get("cmd")

        if command == "create":
            if person is not None or created is not None:
                raise Fatal("exists")
            label = check_label(message.get("label"))
            created = {
                "name": name,
                "label": label,
                # The owner is the first person committed into an empty store
                # (plan-engine.md §3.1) -- and "first" is a question only the
                # locked read at `done` can answer, so both flags are decided
                # there and left false here. Deciding them from this read would
                # let two sessions opened against an empty store each commit as
                # owner, and a store with two owners is `store_corrupt` for
                # every verb until root deletes a file by hand.
                "owner": False,
                "sudo": False,
                "lock": False,
                "created": int(time.time()),
                "appearances": [],
            }

        elif command == "capture":
            target = person if person is not None else created
            if target is None:
                # A capture for a person who neither exists nor was created:
                # the name names nobody, which is what invalid_name says.
                raise Fatal("invalid_name")
            appearance = check_label(message.get("appearance"))
            labels = set(a["label"] for a in target["appearances"]) | set(captured)
            if appearance not in labels and len(labels) >= MAX_APPEARANCES:
                raise Fatal("appearance_limit")
            emit({"event": "capturing"})
            result = capture(appearance, threshold)
            if result["event"] == "captured":
                encoding = result.pop("encoding")
                captured[appearance] = {"label": appearance,
                                        "time": int(time.time()),
                                        "encoding": encoding}
            emit(result)

        elif command == "done":
            if not captured:
                # Nothing was recorded, so there is nothing to save -- and a
                # person with no appearances is exactly what "no empty people"
                # rules out (plan-merged.md §1 row 5).
                break
            with store_lock():
                # Re-read under the lock: this is the first moment the store is
                # being written, and it may have changed since `ready`. Every
                # decision below is made from THIS read -- the one in hand is
                # minutes old, and a session is the one verb here that is open
                # long enough for the store to move underneath it.
                people = read_all()
                fresh = find(people, name)
                if person is None and fresh is not None:
                    raise Fatal("exists")
                if person is not None and fresh is None:
                    # The person was removed while this session was open.
                    # Re-appending the copy `ready` read would resurrect them
                    # with the flags they had when they were deleted -- Sudo
                    # included -- which is not a recording, it is an undelete.
                    raise Fatal("no_person")
                if fresh is not None:
                    target = fresh
                else:
                    if created is None:
                        raise Fatal("invalid_name")
                    if len(people) >= MAX_PEOPLE:
                        raise Fatal("person_limit")
                    # Owner and Sudo, decided here and nowhere else: whoever
                    # takes the lock with an empty store in front of them is the
                    # owner, and the session that loses the race is an ordinary
                    # second person rather than a second owner.
                    target = created
                    target["owner"] = not people
                    target["sudo"] = not people
                    people.append(target)
                for appearance in captured.values():
                    kept = [a for a in target["appearances"]
                            if a["label"] != appearance["label"]]
                    if len(kept) >= MAX_APPEARANCES:
                        raise Fatal("appearance_limit")
                    target["appearances"] = kept + [appearance]
                # The same validation every record is read back through, applied
                # before this one is written: a record that would not survive
                # read_all() must not be what makes the store corrupt.
                validate_record(record_path(name), target)
                write_json(record_path(name), target, 0o600)
                summary = regenerate(people)
            committed = True
            audit("enrolled %s: %d appearance(s) this session, %d in all; "
                  "owner=%s sudo=%s lock=%s; sudo set now %d face(s)"
                  % (name, len(captured), len(target["appearances"]),
                     target["owner"], target["sudo"], target["lock"],
                     summary["sudo_faces"]))
            emit({"event": "saved", "person": public(target)})
            break

        else:
            prose("ignoring an unknown command")

        # A command was handled, so the idle clock starts again -- from AFTER
        # the work, or a capture that took its full forty seconds would spend
        # forty seconds of the allowance for being slow rather than absent. The
        # `continue`s above deliberately do not reach this line: a stream of
        # lines that are not commands must not hold the authorisation open.
        idle_until = time.monotonic() + idle_seconds

    if not committed:
        # EOF, an expired deadline, or `done` with nothing captured. Nothing was
        # written in any of the three: the store lock was never taken, and the
        # temp models were deleted as they were read (plan-merged.md §2.4).
        emit({"event": "discarded"})
    return 0


def main(argv):
    if not argv:
        emit({"error": "no_verb"})
        return 1
    verb = argv[0]
    try:
        if verb == "regenerate":
            cmd_regenerate()
        elif verb == "enroll-session":
            ensure_dirs()
            return cmd_enroll_session(argv[1])
        elif verb == "set-label":
            cmd_set_label(check_name(argv[1]), stdin_json())
        elif verb == "set-permission":
            cmd_set_permission(check_name(argv[1]), argv[2], argv[3] == "on")
        elif verb == "remove-appearance":
            cmd_remove_appearance(check_name(argv[1]), stdin_json())
        elif verb == "remove-person":
            cmd_remove_person(check_name(argv[1]))
        elif verb == "sudo-faces":
            # Read-only, for the caller that has to decide whether removing a
            # permission just emptied the sudo set (plan-engine.md §3.4).
            people = read_all()
            emit({"sudo_faces": len(model_entries(people, "sudo")),
                  "lock_faces": len(model_entries(people, "lock"))})
        else:
            emit({"error": "unknown_verb"})
            return 1
    except Fatal as fatal:
        document = {"error": fatal.code}
        document.update(fatal.extra)
        if verb == "enroll-session":
            # One error shape per verb: a session reports on the stream, because
            # the GUI is parsing events and never a second document (§2.4).
            document = {"event": "error", "error": fatal.code}
            document.update(fatal.extra)
        emit(document)
        return 1
    except Busy:
        emit({"error": "busy"})
        return 3
    except (IndexError, KeyError):
        emit({"error": "bad_arguments"})
        return 1
    except OSError as error:
        if error.errno == errno.EPIPE:
            return 0
        emit({"error": "store_write_failed"})
        return 1
    return 0


sys.exit(main(sys.argv[1:]))
STORE_PY_END

# python3 is the engine's own language, but this helper installs and removes
# Face on machines that have no engine yet, so the dependency is asserted where
# it is needed rather than at the top of the file.
require_python() {
  command -v python3 >/dev/null 2>&1 || die "python_missing"
}

# -I: isolated. No PYTHONPATH, no user site-packages, and -- the one that
# matters here -- no current directory at the front of sys.path, so a `json.py`
# in whatever directory a by-hand `sudo omarchy-face-admin …` was run from is
# not what root imports. (`cd /` at the top of this file is the other half.)
# The store script needs nothing but the standard library; the engine calls in
# it are a different matter and are NOT isolated -- howdy's own code needs the
# site-packages dlib and cv2 live in.
store_py() { python3 -I -c "$STORE_PY" "$@"; }

# One or more keys added to a document the store printed.
#
# It used to be `doc="${doc%\}}"',"unwired":"sudo"}'`, which is correct for
# every shape the store emits today and stops being correct the first time one
# of them ends in anything else -- a nested object, a trailing newline inside
# the document, a verb that answers with an array. This parses instead, and
# falls back to the original document if that fails, because a store change that
# has already happened must not be reported as a failure by its own annotation.
json_merge() { # json_merge <document> <key> <value>…
  local doc=$1 merged
  shift
  merged=$(python3 -I -c '
import json, sys
doc = json.load(sys.stdin)
if not isinstance(doc, dict):
    raise SystemExit(1)
argv = sys.argv[1:]
doc.update(dict(zip(argv[0::2], argv[1::2])))
sys.stdout.write(json.dumps(doc, separators=(",", ":")))
' "$@" <<<"$doc" 2>/dev/null) && [[ -n $merged ]] || merged=$doc
  printf '%s' "$merged"
}

# Names arrive in argv and are validated here as well as in the store
# (plan-merged.md §2 rule 4). The shell check is first because it decides what a
# `die` looks like: the store answers in the verb's own shape, and by the time
# it runs the argument has already been handed to python.
name_rule_ok() { [[ $1 =~ ^[a-z][a-z0-9-]{0,23}$ ]]; }

# Invariant 1 of plan-engine.md §3.4: `sudo=true` in the config needs a non-empty
# sudo set, so a change that empties it unwires PAM in the same call. Phase 5
# owns the wiring; this is the half that cannot wait for it, because the store
# verbs that empty the set are this phase's.
#
# Nothing here is reached before phase 5 has wired sudo at least once: on a
# machine where `sudo=false` (every machine until then) the caller does not call
# it at all.
#
# 0 unwired · 1 the lines are still in the file, but they no longer do anything.
#
# **The config goes first, and that order is the whole of it.** Both helpers read
# `sudo` from the config before they do anything else (§4.2 check 2, §4.3 step
# 1), so writing `sudo=false` is what makes them inert -- not deleting the lines.
# Deleting first and writing second has a failure in the middle of it: a block
# somebody edited by hand makes pam_remove_block refuse, and a caller that gave
# up there would leave `sudo=true` behind, which is a machine still asking the
# camera on every sudo while its Settings page says the feature is off. Written
# this way round, the refusal costs a stale block in a file and nothing else: the
# gate skips at the config check, the verifier exits 1, and the `sudo` row says
# so. (pam_remove_block's 2 is "there was nothing of ours in it", which is not a
# failure -- the stack is already what the config now says it is.)
unwire_sudo() {
  local status
  config_set sudo false
  pam_remove_block "$PAM_DIR/sudo"
  status=$?
  if ((status == 1)); then
    audit "sudo is off, but $PAM_DIR/sudo is not the shape face wrote and its lines are still there (they do nothing now)"
    return 1
  fi
  audit "sudo unwired: no face can approve sudo any more"
  return 0
}

# One key of /etc/omarchy-face/config, rewritten in place. Same temp + rename as
# everything else root writes here, and the file stays 0644 because the status
# helper runs as the owner and reads it.
config_set() { # config_set <key> <value>
  local key=$1 value=$2 tmp
  [[ -f $CONFIG_FILE ]] || return 1
  tmp=$CONFIG_FILE.tmp
  {
    sed "/^[[:space:]]*${key}[[:space:]]*=/d" "$CONFIG_FILE"
    printf '%s=%s\n' "$key" "$value"
  } >"$tmp" || { rm -f "$tmp"; return 1; }
  chmod 0644 "$tmp"
  chown root:root "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

# The count the unwire rule turns on, read back from the store rather than
# tracked by the caller.
sudo_faces_now() {
  local doc
  doc=$(store_py sudo-faces 2>/dev/null) || return 1
  sed -n 's/.*"sudo_faces":\([0-9]\{1,\}\).*/\1/p' <<<"$doc" | head -1
}

# Run one store verb and apply the unwire rule to its result.
#
# The store answers with a JSON document; when that document leaves sudo with no
# faces behind it and the config still says sudo is on, PAM is unwired here and
# the document gains `"unwired":"sudo"` (plan-merged.md §2.3). The document is
# built by this file, so appending one key to it is a text edit on a shape we
# control -- checked for that shape before it is touched.
store_verb() { # store_verb <verb> [args…]  (stdin is passed through)
  local doc status
  doc=$(store_py "$@")
  status=$?
  if ((status != 0)); then
    printf '%s\n' "$doc"
    exit "$status"
  fi
  if [[ $(config_get sudo false) == true ]] && [[ $(sudo_faces_now) == 0 ]]; then
    if unwire_sudo; then
      doc=$(json_merge "$doc" unwired sudo)
    else
      # The store change stands -- it is written and the derived sets are
      # rebuilt -- but sudo is still wired to a helper with no faces behind it,
      # and saying so is the only way the owner finds out. The sudo row's own
      # check is what reports it afterwards; this is what reports it now.
      doc=$(json_merge "$doc" unwired failed error pam_edit_failed)
    fi
  fi
  printf '%s\n' "$doc"
  exit 0
}

# --- verbs -------------------------------------------------------------------

case $verb in

  install-system)
    # One entry point, called only by system/install.sh:
    #
    #   install-system --verified-snapshot DIR ACCOUNT
    #
    # install.sh has already copied the ten files into a root-only directory
    # under /run and checked every byte against the SHA-256 pins in its own
    # authorised text, and it runs THIS helper out of that snapshot. So nothing
    # here reads the plugin folder: that folder is writable by the account and by
    # anything running as it, and a file swapped before a copy is taken would
    # otherwise be installed as root.
    #
    # There used to be a second form with no arguments, reached through Face's
    # own auth_self action, that took its own snapshot of the plugin folder for
    # updates. The installed helper cannot know a newer release's pins, so that
    # snapshot could not be checked; updates now go through install.sh and the
    # administrator prompt like the first install.
    #
    # Refused when PKEXEC_UID is set, so it cannot be reached through Face's own
    # action: only something that is already root -- install.sh, under polkit's
    # generic auth_admin exec action -- can hand over a snapshot.
    [[ ${1:-} == --verified-snapshot ]] || die "use_installer"
    [[ -z $caller_uid ]] || die "not_owner"
    given_snapshot=${2:-}
    account=${3:-}
    [[ -n $given_snapshot && -n $account ]] || die "bad_arguments"
    [[ $account != root ]] || die "unknown_account"
    id -u -- "$account" >/dev/null 2>&1 || die "unknown_account"
    first_install=0
    [[ -e $CONFIG_FILE ]] || first_install=1
    if ((!first_install)); then
      [[ $(config_get account) == "$account" ]] || die "not_owner"
    fi

    # The snapshot has to be what install.sh made: a directory directly under
    # /run, root's, 0700, and not a link to anywhere else.
    [[ $given_snapshot =~ ^/run/omarchy-face-install\.[A-Za-z0-9]+$ ]] || die "snapshot_unsafe"
    [[ -d $given_snapshot && ! -L $given_snapshot ]] || die "snapshot_unsafe"
    [[ $(stat -c '%u %a' -- "$given_snapshot" 2>/dev/null) == "0 700" ]] || die "snapshot_unsafe"

    # Both paths, and whoever the caller is. A machine whose Face account is not
    # an administrator would make these helpers -- which phase 5 runs as root
    # from sudo's PAM stack -- a way to become root with an ordinary user's
    # own password, because Face's action is auth_self.
    assert_account_is_admin "$account"

    # Adopted, so the EXIT trap removes it on every path. This helper is running
    # out of it; bash keeps reading a script whose file has been unlinked.
    snapshot_dir=$given_snapshot
    tmp=$snapshot_dir
    verify_snapshot_shape "$tmp"
    snapshot_version "$tmp"

    if ((!first_install)) && old_version=$(installed_version); then
      if [[ $old_version == "$new_version" ]]; then
        if snapshot_differs "$tmp" && ! version_is_dev "$new_version"; then
          # Same released version, different bytes. Somebody edited either the
          # plugin copy or the installed one, and there is no way to tell which
          # from here -- so this is the one repair path that refuses rather than
          # asking the owner to approve it (risk 7, §10.1: the row is `broken`
          # with no Fix, and the answer is to reinstall the plugin).
          die "version_mismatch"
        fi
      elif ! version_newer "$new_version" "$old_version" && ! version_is_dev "$new_version"; then
        # The plugin is older than what is installed. Not a repair, and the
        # Setup row never offers it; refusing keeps a stale checkout from
        # quietly downgrading the root-owned half.
        die "version_mismatch"
      fi
    fi

    install_from_snapshot "$tmp"
    cleanup_snapshot

    if ((first_install)); then
      install -d -o root -g root -m 0755 "$CONFIG_DIR" || die "install_failed"
      # sudo and lock start off. Nothing is wired until somebody asks for it,
      # and phase 5's gate is the first time sudo may be.
      umask 022
      printf 'account=%s\nsudo=false\nlock=false\n' "$account" >"$CONFIG_FILE.tmp" || die "install_failed"
      chmod 0644 "$CONFIG_FILE.tmp"
      chown root:root "$CONFIG_FILE.tmp"
      mv -f "$CONFIG_FILE.tmp" "$CONFIG_FILE" || die "install_failed"
      audit "system files installed for $account by uid ${caller_uid:-0} (version $new_version)"
    else
      audit "system files updated to $new_version by uid ${caller_uid:-0} (${#changed[@]} changed)"
    fi

    systemctl_step daemon-reload
    systemctl_step enable --now omarchy-faced.socket

    # The first install ends by starting the engine build (plan-engine.md §5.1):
    # a machine that has just had Face installed has no engine, and the Setup
    # view's next row is the one that would otherwise ask for a second prompt to
    # say so. An UPDATE never starts one -- system files change far more often
    # than the engine does, and rebuilding howdy because a QML file moved is not
    # what "Update Face system files" says on the button.
    #
    # `started` is false rather than fatal when the job could not start: the
    # system half is installed either way, and the `engine` row's own Fix is the
    # way to try again.
    started=false
    if ((first_install)); then
      if start_install_job; then
        started=true
      else
        warnings+=("the engine build did not start: $job_error")
      fi
    fi

    printf '{"ok":true,"version":%s,"changed":%s,"warnings":%s,"started":%s}\n' \
      "$(json_string "$new_version")" "$(json_array "${changed[@]}")" \
      "$(json_array "${warnings[@]}")" "$started"
    exit 0
    ;;

  install-engine)
    # Build the engine, or repair one that is there but not configured. The
    # answer is `{"started":true}`, never the build's own result: the build
    # outlives this process by design, and a verb that waited for it would be
    # back to a job that dies with the popup.
    assert_owner
    [[ -n $account ]] || die "not_installed"

    start_install_job
    case $? in
      0) ;;
      3) die "install_running" 3 ;;
      *) die "${job_error:-start_failed}" ;;
    esac
    printf '{"started":true}\n'
    exit 0
    ;;

  build-engine)
    # The job itself (plan-engine.md §5.2). Only ever run by the transient unit
    # install-engine starts.
    #
    # Refused when PKEXEC_UID is set, and the reason is not access control --
    # the owner can already start this work with install-engine. It is that a
    # pkexec'd build would run as a child of the popup's Process and be
    # SIGKILLed when the popup closes, half way through `pacman -U`. The only
    # supported way in is the unit.
    [[ -z $caller_uid ]] || die "not_owner"

    # One build at a time, whoever asked. The flock is taken before any state is
    # written, so a second job cannot stamp `running` over the first one's step.
    ensure_run_dir
    open_lock 8 "$INSTALL_LOCK" || die "install_failed"
    flock -n 8 || die "install_running" 3

    trap build_interrupted TERM INT HUP
    read_install_started
    install_step=""
    # PKEXEC_UID is gone by the time the unit runs (this is root starting root),
    # so the uid is carried in for the journal only -- install-engine's own line
    # is the authenticated one, and this is what ties the two together.
    audit "engine build running (requested by uid ${OMARCHY_FACE_REQUESTER:-unknown})"
    # Decided once, before any step: it needs systemd to answer, and a machine
    # where it does not is one to stop on rather than to start an unstoppable
    # build on.
    compute_build_binding

    # Everything the build needs is already there, and it is the CPU-only build:
    # then deps, fetch, build and install have nothing to do and the job is one
    # `configure` away from done. This is the ordinary path after a
    # `purge --keep-packages`, and it is why the Remove view can offer to keep
    # the packages at all.
    rebuild=1
    if engine_packages_cpu_only; then
      rebuild=0
      install_notes+=("howdy $(pacman -Q howdy 2>/dev/null | awk '{print $2}') was already installed")
    fi

    # 1. deps
    step_begin deps
    if ((rebuild)); then
      # A held db.lck is somebody else's pacman, not a broken machine: say so
      # rather than failing inside pacman a minute later.
      [[ -e /var/lib/pacman/db.lck ]] && build_fail pacman_locked
      # No `-Sy`. Refreshing the databases without upgrading is the partial
      # upgrade Arch tells you never to do, and a GUI button is the last place
      # to do it: a machine whose databases are too old to resolve these names
      # fails here with pacman's own message in the log.
      pacman -S --needed --noconfirm "${BUILD_DEPS[@]}" >>"$INSTALL_LOG" 2>&1 ||
        build_fail deps_failed
    else
      install_log "skipped: the engine is already installed"
    fi

    # 2. fetch, and 3. build, both as the build user.
    step_begin fetch
    if ((rebuild)); then
      run_builder_phase fetch
    else
      install_log "skipped"
    fi

    step_begin build
    if ((rebuild)); then
      run_builder_phase build
    else
      install_log "skipped"
    fi

    # 4. install. Root's own checks come first, on the package FILES, because
    #    the patch that asked for a CPU-only build ran as a uid whose whole job
    #    was to run somebody else's PKGBUILD.
    step_begin install
    if ((rebuild)); then
      find_package "$BUILD_STATE/python-dlib" python-dlib || build_fail dlib_package_missing
      dlib_pkg=$found_package
      dlib_info=$(package_info "$dlib_pkg") || build_fail dlib_package_missing
      grep -qx "pkgname = python-dlib" <<<"$dlib_info" || build_fail dlib_package_missing
      # The one check this whole phase exists for. A dlib built against CUDA
      # depends on it; nothing else about the file says so as plainly.
      if grep -qiE '^depend = (cuda|cudnn)' <<<"$dlib_info"; then
        build_fail cuda_in_package
      fi
      if compgen -G "$BUILD_STATE/python-dlib/python-dlib-cuda-*.pkg.tar.*" >/dev/null; then
        build_fail cuda_in_package
      fi

      find_package "$BUILD_STATE/howdy" howdy || build_fail howdy_package_missing
      howdy_pkg=$found_package
      grep -qx "pkgname = howdy" <<<"$(package_info "$howdy_pkg")" || build_fail howdy_package_missing
      # The drop-in, checked in the package rather than in the PKGBUILD. If the
      # AUR spells the install line differently one day the patch above misses
      # it, and this is what still knows.
      dropin_built=0
      if bsdtar -tf "$howdy_pkg" 2>/dev/null | grep -q '10-howdy\.conf'; then
        dropin_built=1
        install_notes+=("the built howdy package carried the polkit drop-in; it was removed after installing")
      fi

      install_log "installing $(basename -- "$dlib_pkg") and $(basename -- "$howdy_pkg")"
      pacman -U --noconfirm --asdeps "$dlib_pkg" >>"$INSTALL_LOG" 2>&1 || build_fail dlib_install_failed
      pacman -U --noconfirm "$howdy_pkg" >>"$INSTALL_LOG" 2>&1 || build_fail howdy_install_failed

      if ((dropin_built)) || [[ -e $HOWDY_DROPIN ]]; then
        rm -f -- "$HOWDY_DROPIN"
        rmdir /usr/lib/systemd/system/polkit-agent-helper@.service.d 2>/dev/null
        systemctl daemon-reload >/dev/null 2>&1
      fi
    else
      install_log "skipped"
    fi

    # 5. configure. howdy's config.ini is root-only (the package installs the
    #    whole directory 0600), so everything the unprivileged status helper
    #    needs to judge this is copied into engine.json afterwards (§11.4).
    step_begin configure
    [[ -f $HOWDY_CONFIG ]] || build_fail howdy_config_missing

    camera_doc=$("$CAMERA" --describe 2>/dev/null) || build_fail no_ir_camera
    ir_path=$(json_value "$camera_doc" ir)
    ir_size=$(json_value "$camera_doc" irSize)
    [[ -n $ir_path ]] || build_fail no_ir_camera

    frame_width=-1
    frame_height=-1
    if [[ $ir_size =~ ^([0-9]+)x([0-9]+)$ ]]; then
      frame_width=${BASH_REMATCH[1]}
      frame_height=${BASH_REMATCH[2]}
    else
      ir_size=""
    fi

    # One anchored edit per key, each read back. `certainty` and `dark_threshold`
    # stay stock: they are howdy's own judgement about faces, and phase 4
    # measures against them rather than moving them first.
    set_config_key device_path "$ir_path" || build_fail config_key_missing
    set_config_key frame_width "$frame_width" || build_fail config_key_missing
    set_config_key frame_height "$frame_height" || build_fail config_key_missing
    set_config_key recording_plugin opencv || build_fail config_key_missing
    # 5 s, not howdy's stock 4: the lock screen re-blanks 5 s after a wake
    # (§9.2), and sudo uses the same value. Disclosed as risk 8.
    set_config_key timeout 5 || build_fail config_key_missing
    set_config_key capture_failed false || build_fail config_key_missing
    set_config_key capture_successful false || build_fail config_key_missing
    set_config_key end_report true || build_fail config_key_missing
    set_config_key disabled false || build_fail config_key_missing

    certainty_raw=$(config_ini_get certainty)
    [[ $certainty_raw =~ ^[0-9]+([.][0-9]+)?$ ]] || build_fail config_key_missing
    # howdy's config is on a 1-10 scale and every number in Face's contract is on
    # 0-1 (plan-merged.md §2 rule 8). The division happens once, here.
    certainty=$(awk -v value="$certainty_raw" 'BEGIN { printf "%.4g", value / 10 }')

    howdy_version=$(pacman -Q howdy 2>/dev/null | awk '{print $2}')
    [[ -n $howdy_version ]] || build_fail howdy_package_missing

    [[ -d $STORE_DIR ]] || install -d -o root -g root -m 0755 "$STORE_DIR" || build_fail install_failed
    engine_tmp=$ENGINE_FILE.tmp
    printf '{"howdy":%s,"threshold":%s,"timeout":5,"device_path":%s,"frameSize":%s,"recording_plugin":"opencv","end_report":true,"certainty":%s,"at":%s}\n' \
      "$(json_string "$howdy_version")" "$certainty" "$(json_string "$ir_path")" \
      "$(json_string "$ir_size")" "$certainty" "$(now_seconds)" >"$engine_tmp" ||
      build_fail install_failed
    chmod 0644 "$engine_tmp"
    chown root:root "$engine_tmp"
    mv -f "$engine_tmp" "$ENGINE_FILE" || build_fail install_failed
    install_log "configured howdy $howdy_version for $ir_path${ir_size:+ at $ir_size}"

    # 6. done. The build directory goes now rather than at the next build: it
    #    holds a source tree and two packages, and keeping them would mean a
    #    machine that has finished still carrying half a gigabyte for nothing.
    step_begin "done"
    build_dir_remove
    write_install "done" "done" ""
    audit "engine build finished: howdy $howdy_version, CPU-only dlib"
    printf '{"ok":true,"howdy":%s,"notes":%s}\n' \
      "$(json_string "$howdy_version")" \
      "$(json_array ${install_notes[@]+"${install_notes[@]}"})"
    exit 0
    ;;

  purge)
    # Remove the system half, in a fixed order, every step tolerating its target
    # being absent (plan-engine.md §10.2 step 2). A half-installed machine must
    # purge as cleanly as a finished one.
    keep_packages=0
    [[ ${1:-} == --keep-packages ]] && keep_packages=1
    assert_owner_unless_uninstalled

    # A build writing into /var/lib while this deletes it is the one way purge
    # can leave debris it did not choose to leave.
    if systemctl is-active --quiet "$INSTALL_UNIT" 2>/dev/null; then
      die "install_running" 3
    fi

    # With no config there is no account this machine belongs to, so this is not
    # the owner asking to remove their own Face -- it is anybody active asking.
    # That is allowed, because a half-installed machine has to be cleanable, but
    # it is restricted to what Face itself put there: the table's own files,
    # Face's own directories, Face's own marked PAM block and Face's own derived
    # models. No packages, and nothing that belongs to somebody else.
    minimal=0
    [[ -n $account ]] || minimal=1

    # (An apostrophe inside ${x:+…} inside double quotes is a parse error in
    # bash, not a typo waiting to be spotted -- hence the plain variable.)
    minimal_note=""
    ((minimal)) && minimal_note=" (no config: restricted to files Face installed)"
    audit "purge requested by uid ${caller_uid:-0}$minimal_note"
    incomplete=()

    # 1. PAM first. A stack pointing at helpers that have just been deleted is
    #    the one outcome of a half-finished purge that could actually hurt.
    #
    #    pam_remove_block only ever deletes our own marked block, and only from
    #    a file whose block is exactly the shape we wrote. A file without it is
    #    not touched, not even copied, so `purge` on a machine where sudo was
    #    never wired leaves /etc/pam.d byte-for-byte as it was.
    for pam_file in "$PAM_DIR"/*; do
      [[ -f $pam_file ]] || continue
      pam_remove_block "$pam_file"
    done

    # One sweep afterwards, rather than trusting the loop's own account of
    # itself: anything of ours still in a stack is incomplete, whether it was
    # refused, appeared while we worked, or could not be locked.
    for pam_file in "$PAM_DIR"/*; do
      [[ -f $pam_file ]] || continue
      grep -q "^${PAM_BEGIN}\$" "$pam_file" 2>/dev/null && incomplete+=("$pam_file")
    done

    # 2. The daemon, before the files it runs.
    systemctl disable --now omarchy-faced.socket >/dev/null 2>&1
    systemctl stop omarchy-faced.service >/dev/null 2>&1
    rm -f "$UNIT_DIR/omarchy-faced.socket" "$UNIT_DIR/omarchy-faced.service"
    systemctl daemon-reload >/dev/null 2>&1

    # 3. Models, then state. The models are derived files inside howdy's own
    #    directory, so they go by name rather than by removing the directory.
    rm -f "$MODELS"/omarchy-face.*.dat 2>/dev/null
    rm -rf "$STORE_DIR" "$RUN_DIR" "$CONFIG_DIR" "$BUILD_STATE"
    # systemd leaves /var/lib/<name> as a symlink to a DynamicUser unit's
    # StateDirectory. `rm -rf` on the target does not take the link with it, and
    # a dangling one is debris a removal should not leave.
    [[ -L /var/lib/omarchy-face-build ]] && rm -f /var/lib/omarchy-face-build

    # 4. Packages. Scope says remove everything; --keep-packages is the Remove
    #    view's "saves a rebuild" tick. Never in minimal mode: howdy may be
    #    installed on this machine for reasons that have nothing to do with
    #    Face, and "no config" is not evidence that it is not.
    removed_packages=()
    if ((!keep_packages && !minimal)); then
      for package in howdy python-dlib; do
        pacman -Q "$package" >/dev/null 2>&1 || continue
        if pacman -Rns --noconfirm "$package" >/dev/null 2>&1; then
          removed_packages+=("$package")
        else
          incomplete+=("$package")
        fi
      done
    fi

    # 5. The policy first, then the helpers, this file last: bash holds an open
    #    descriptor on the script it is running, so unlinking the name is safe,
    #    but only once nothing else still needs to be run.
    rm -f "$POLICY"
    for entry in "${SYSTEM_FILES[@]}"; do
      dest=${entry#*:}; dest=${dest%:*}
      [[ $dest == /usr/local/bin/omarchy-face-admin ]] && continue
      rm -f "$dest"
    done
    rm -f /usr/local/bin/omarchy-face-admin

    # What is left, checked rather than assumed. The GUI stops before removing
    # the plugin when this is not empty (plan-gui.md §7.1).
    for entry in "${SYSTEM_FILES[@]}"; do
      dest=${entry#*:}; dest=${dest%:*}
      [[ -e $dest ]] && incomplete+=("$dest")
    done
    for leftover in "$STORE_DIR" "$RUN_DIR" "$CONFIG_DIR" "$BUILD_STATE"; do
      [[ -e $leftover ]] && incomplete+=("$leftover")
    done
    [[ -L /var/lib/omarchy-face-build ]] && incomplete+=("/var/lib/omarchy-face-build")
    # `systemctl disable --now` can fail without saying so on a machine where
    # the unit is masked, or wedged, or the manager is busy. The unit FILES are
    # gone by now, so a socket still listening is an orphan holding a path in
    # /run that nothing owns any more, and it needs a root `systemctl
    # reset-failed` or a reboot -- which is worth saying out loud.
    if [[ -d /run/systemd/system ]] && systemctl is-active --quiet omarchy-faced.socket 2>/dev/null; then
      incomplete+=("omarchy-faced.socket is still active")
    fi
    compgen -G "$MODELS/omarchy-face.*.dat" >/dev/null && incomplete+=("$MODELS/omarchy-face.*.dat")

    audit "purge finished by uid ${caller_uid:-0}; ${#incomplete[@]} left"
    printf '{"ok":true,"incomplete":%s,"packages":%s}\n' \
      "$(json_array "${incomplete[@]}")" "$(json_array "${removed_packages[@]}")"
    exit 0
    ;;

  purge-legacy)
    # The old install's leavings (plan-engine.md §2, §10.1 row `legacy`). Only
    # artefacts the rewrite never creates, plus files that share a name with one
    # of ours and lack the `omarchy-face v2` marker.
    # Unlike `purge`, this one deletes things Face never installed: a howdy
    # polkit drop-in that belongs to the howdy package, model files belonging to
    # a stock howdy setup, PAM backups somebody may be keeping. That is only the
    # right thing to do for the account this machine's Face belongs to, so with
    # no config it is not offered at all.
    [[ -n $account ]] || die "not_installed"
    assert_owner
    audit "purge-legacy requested by uid ${caller_uid:-0}"
    removed=()

    # Old-only helpers: names this rewrite has no file for.
    for old in face face-engine-howdy face-notify face-set-idle-lock face-uninstall \
               hw-ir-camera remove-security-face remove-security-face-lock \
               security-probe setup-security-face setup-security-face-lock; do
      [[ -e /usr/local/bin/omarchy-$old ]] || continue
      rm -f "/usr/local/bin/omarchy-$old" && removed+=("/usr/local/bin/omarchy-$old")
    done

    # Shared names, old contents. An unmarked file at one of our paths is the
    # old version of that helper; ours all carry the marker (§8.1).
    for entry in "${SYSTEM_FILES[@]}"; do
      dest=${entry#*:}; dest=${dest%:*}
      [[ -f $dest ]] || continue
      has_v2_marker "$dest" && continue
      rm -f "$dest" && removed+=("$dest")
    done

    # The old polkit action lived in the same file name as ours, so the marker
    # check above catches it; this catches a file that carries the marker but
    # still declares the old action id.
    if [[ -f $POLICY ]] && grep -q 'no.graveklar.face.admin' "$POLICY"; then
      rm -f "$POLICY" && removed+=("$POLICY")
    fi

    # PAM: the old lock stack, the old backups, and face lines anywhere they do
    # not belong. A marked block is `purge`'s business, not this verb's.
    [[ -e /etc/pam.d/omarchy-lock-face ]] && rm -f /etc/pam.d/omarchy-lock-face &&
      removed+=("/etc/pam.d/omarchy-lock-face")
    for backup in /etc/pam.d/*.omarchy-face.bak; do
      [[ -e $backup ]] || continue
      rm -f "$backup" && removed+=("$backup")
    done

    # The howdy polkit drop-in, which gave polkit's agent helper camera and
    # uinput access for a design that no longer puts face in polkit (E9).
    drop_in=/usr/lib/systemd/system/polkit-agent-helper@.service.d/10-howdy.conf
    if [[ -e $drop_in ]]; then
      rm -f "$drop_in" && removed+=("$drop_in")
      rmdir /usr/lib/systemd/system/polkit-agent-helper@.service.d 2>/dev/null
      systemctl daemon-reload >/dev/null 2>&1
    fi

    # Old model files and the old summary. The new store writes
    # omarchy-face.<set>.dat and never these.
    for model in "$MODELS"/identity-*.dat; do
      [[ -e $model ]] || continue
      rm -f "$model" && removed+=("$model")
    done
    if [[ -n $account && -e $MODELS/$account.dat ]]; then
      rm -f "$MODELS/$account.dat" && removed+=("$MODELS/$account.dat")
    fi
    [[ -e $STORE_DIR/models.json ]] && rm -f "$STORE_DIR/models.json" &&
      removed+=("$STORE_DIR/models.json")

    # Deliberately NOT removed here: the menu entries in the owner's
    # omarchy-menu.jsonc and any `added by omarchy-face` lock clone. Both live
    # under ~/.config/omarchy, both are the user's own files, and a write to the
    # plugins folder from a root process would reload every bar widget and close
    # the popup that asked for this (E13). The status row reports them and the
    # README says to delete them.
    audit "purge-legacy removed ${#removed[@]} artefacts"
    printf '{"ok":true,"removed":%s}\n' "$(json_array "${removed[@]}")"
    exit 0
    ;;

  enroll-session)
    # The only capture path (plan-engine.md §3.5). One owner prompt per session,
    # drawn by pkexec before this file runs at all, so the first line printed
    # here -- `ready` -- IS the authorised signal the card's countdown starts on.
    #
    # Errors are events on the stream, including the ones raised before `ready`:
    # the GUI parses stdout line by line and never needs a second document.
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python
    name=${1:-}
    if ! name_rule_ok "$name"; then
      printf '{"event":"error","error":"invalid_name"}\n'
      exit 1
    fi
    audit "enroll-session for $name, by uid ${caller_uid:-0}"
    # exec, so python owns the standard streams this process was given: the
    # session is a conversation on stdin, and a bash layer in the middle is a
    # buffer between the GUI and the engine for no reason at all.
    exec python3 -I -c "$STORE_PY" enroll-session "$name"
    ;;

  set-label)
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python
    name=${1:-}
    name_rule_ok "$name" || die "invalid_name"
    audit "set-label for $name, by uid ${caller_uid:-0}"
    # No unwire rule: a label change cannot empty the sudo set.
    store_py set-label "$name"
    exit $?
    ;;

  set-permission)
    # Granting Sudo to a face IS granting it root as this account, which is why
    # it is behind the same prompt as everything else here (plan-engine.md §3.4
    # invariant 3).
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python
    name=${1:-}
    which=${2:-}
    value=${3:-}
    name_rule_ok "$name" || die "invalid_name"
    [[ $which == sudo || $which == lock ]] || die "bad_arguments"
    [[ $value == on || $value == off ]] || die "bad_arguments"
    audit "set-permission $which=$value for $name, by uid ${caller_uid:-0}"
    store_verb set-permission "$name" "$which" "$value"
    ;;

  remove-appearance)
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python
    name=${1:-}
    name_rule_ok "$name" || die "invalid_name"
    audit "remove-appearance for $name, by uid ${caller_uid:-0}"
    store_verb remove-appearance "$name"
    ;;

  remove-person)
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python
    name=${1:-}
    name_rule_ok "$name" || die "invalid_name"
    audit "remove-person $name, by uid ${caller_uid:-0}"
    store_verb remove-person "$name"
    ;;

  regenerate)
    # Every derived file, rebuilt from people/*.json alone. A record that does
    # not validate stops the whole thing before anything is written, so a corrupt
    # store cannot take the derived sets with it (plan-merged.md §2.3).
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python
    audit "regenerate, by uid ${caller_uid:-0}"
    store_py regenerate
    exit $?
    ;;

  sudo-on)
    # The one verb that points sudo's auth stack at a camera (plan-engine.md
    # §4.1, §4.4). Everything it checks is a precondition for that being safe,
    # and every one of them is checked here rather than trusted from the GUI:
    # this verb is one pkexec away from any process running as the owner.
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python

    # 1. Derive first. The stack is about to point at
    #    models/omarchy-face.sudo.<account>.dat, and `regenerate` is what makes
    #    that file agree with people/*.json. A corrupt store stops here, before
    #    anything is wired, rather than after.
    regen=$(store_py regenerate)
    regen_status=$?
    if ((regen_status != 0)); then
      printf '%s\n' "$regen"
      exit "$regen_status"
    fi

    # 2. Somebody has to be behind it (§3.4 invariant 1). Read back from the
    #    store's own answer, not from a count the caller carried in.
    faces=$(sed -n 's/.*"sudo_faces":\([0-9]\{1,\}\).*/\1/p' <<<"$regen" | head -1)
    [[ $faces =~ ^[0-9]+$ ]] || die "store_corrupt"
    ((faces > 0)) || die "no_sudo_faces"

    # 3. Nothing points an auth stack at a file somebody else can write. The
    #    same question pam_insert_block asks, asked here too so the answer can
    #    be `helper_unsafe` rather than a generic refusal -- these two are the
    #    files sudo would run as root on every authentication.
    for helper in /usr/local/bin/omarchy-face-gate /usr/local/bin/omarchy-face-verify; do
      file_is_safe "$helper" || die "helper_unsafe"
    done

    # 4. The edit. An intact block already in place is not an error: it is the
    #    `broken` state where the stack was wired and the config was not (a
    #    purge that was interrupted, a config restored from elsewhere), and the
    #    repair for it is to write the config and stop.
    if ! pam_block_intact "$PAM_DIR/sudo"; then
      pam_insert_block "$PAM_DIR/sudo" || die "pam_edit_failed"
    fi

    # A config that could not be written after the block went in would leave the
    # stack pointing at Face with the config saying it is off -- harmless (the
    # gate's check 2 skips) but a state nobody asked for, and the `sudo` row
    # would call it broken. Put the file back the way it was and say so.
    if ! config_set sudo true; then
      pam_remove_block "$PAM_DIR/sudo"
      die "config_write_failed"
    fi
    audit "sudo wired to face by uid ${caller_uid:-0}: $faces face(s) can approve sudo"
    printf '{"ok":true,"sudo_faces":%s}\n' "$faces"
    exit 0
    ;;

  sudo-off)
    # Always allowed (§4.4). Not "allowed unless": every reason this verb could
    # find to refuse -- a store that will not parse, a python that is not
    # installed, a people.json from a future version -- is a reason somebody
    # would want sudo unwired, and a machine whose only way back to a password
    # prompt is a text editor as root is not a machine this plugin may create.
    assert_owner
    [[ -n $account ]] || die "not_installed"

    # Best effort, and deliberately not fatal: the derived sets are rebuilt
    # because the sudo set is about to stop being the thing PAM reads, and a
    # failure to do so must not stand between the owner and an unwired stack.
    if command -v python3 >/dev/null 2>&1; then
      store_py regenerate >/dev/null 2>&1 || true
    fi

    # The config FIRST. It is what both helpers read before they do anything
    # else, so this line -- not the edit below -- is what turns the feature off.
    # The order matters because the edit can refuse: a block somebody has changed
    # by hand is not ours to delete, and an "always allowed" verb that died there
    # before writing the config would leave a machine asking the camera on every
    # sudo while the page that offered the switch says it is off.
    config_set sudo false || die "config_write_failed"

    # 0 removed · 2 there was nothing of ours in it (already off) · 1 refused,
    # and the file is exactly as it was. A refusal is still an error -- the lines
    # are still in the stack and somebody has to look at them -- but they are
    # inert lines now: the gate skips at the config check and the verifier exits
    # 1 without ever reaching a camera.
    pam_remove_block "$PAM_DIR/sudo"
    case $? in
      0 | 2) ;;
      *)
        audit "sudo is off, but its lines could not be removed from $PAM_DIR/sudo (they do nothing now)"
        die "pam_edit_failed"
        ;;
    esac

    audit "sudo unwired from face by uid ${caller_uid:-0}"
    printf '{"ok":true}\n'
    exit 0
    ;;

  lock-on)
    # The setting the daemon reads before it will answer VERIFY-LOCK at all
    # (§6.2). It wires nothing: the lock screen wrapper is a plugin folder the
    # unprivileged `omarchy-face-lock` verbs enable and disable, and this verb
    # never touches it. What it does is make the daemon willing to look.
    assert_owner
    [[ -n $account ]] || die "not_installed"
    require_python

    # Derive first, for the reason `sudo-on` derives first: the daemon compares
    # against models/omarchy-face.lock.<account>.dat, and `regenerate` is what
    # makes that file agree with people/*.json. A corrupt store stops here,
    # before the setting moves, rather than after.
    regen=$(store_py regenerate)
    regen_status=$?
    if ((regen_status != 0)); then
      printf '%s\n' "$regen"
      exit "$regen_status"
    fi

    # Unlike `sudo-on` there is no minimum (plan-merged.md §2.3): turning this
    # on with nobody holding Lock screen is allowed, because the daemon already
    # fails safe -- no lock set means `NO disabled`, so no camera is opened and
    # no lock is ever opened. The Settings page says so in words rather than
    # refusing a switch somebody has a reason to move first.
    faces=$(sed -n 's/.*"lock_faces":\([0-9]\{1,\}\).*/\1/p' <<<"$regen" | head -1)
    [[ $faces =~ ^[0-9]+$ ]] || die "store_corrupt"

    config_set lock true || die "config_write_failed"
    audit "lock screen face unlock on by uid ${caller_uid:-0}: $faces face(s) can open the lock screen"
    printf '{"ok":true,"lock_faces":%s}\n' "$faces"
    exit 0
    ;;

  lock-off)
    # Always allowed, exactly like `sudo-off`, and for the same reason: every
    # thing that could make this verb refuse -- a store that will not parse, a
    # missing python -- is a reason somebody would want face off the lock
    # screen, and a machine whose only way back is a text editor as root is not
    # a machine this plugin may create.
    assert_owner
    [[ -n $account ]] || die "not_installed"

    # The config FIRST. It is what the daemon reads before it does anything
    # else, so this line is what stops a face being tried -- not the derived set
    # below, which is rebuilt afterwards and best effort.
    config_set lock false || die "config_write_failed"
    if command -v python3 >/dev/null 2>&1; then
      store_py regenerate >/dev/null 2>&1 || true
    fi

    audit "lock screen face unlock off by uid ${caller_uid:-0}"
    printf '{"ok":true}\n'
    exit 0
    ;;

  *)
    die "unknown_verb"
    ;;
esac
