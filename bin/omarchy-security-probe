#!/bin/bash

# omarchy:summary=Report this machine's authentication and lock posture as JSON
# omarchy:args=[--pretty]

# Everything here is readable by the user who owns the session. That is the
# point: a security overview that demands a password before it will tell you
# anything is a security overview nobody opens. Changing any of this still
# requires authorisation -- reading it does not.

set -uo pipefail
export PATH=/usr/local/bin:/usr/bin

json_bool() { [[ $1 == 0 ]] && echo true || echo false; }

# --- face ------------------------------------------------------------------
face_hardware=$(omarchy-hw-ir-camera >/dev/null 2>&1; json_bool $?)
face_engine=$(omarchy-face engine 2>/dev/null || echo unknown)
face_installed=$(omarchy-face-engine-"$face_engine" installed >/dev/null 2>&1; json_bool $?)
face_disabled=$([[ -e /etc/omarchy-face/disabled ]] && echo true || echo false)
face_sudo=$(grep -q omarchy-face-verify /etc/pam.d/sudo 2>/dev/null; json_bool $?)
face_polkit=$(grep -q omarchy-face-verify /etc/pam.d/polkit-1 2>/dev/null; json_bool $?)

# Published by omarchy-face-admin after every change; labels and times only.
face_models=null
if [[ -r /run/omarchy-face/models.json ]]; then
  face_models=$(python3 -c '
import json, sys
try:
    print(len(json.load(open("/run/omarchy-face/models.json")).get("models", [])))
except Exception:
    print("null")
' 2>/dev/null || echo null)
fi

# --- fingerprint -----------------------------------------------------------
fp_hardware=$(omarchy-hw-fingerprint >/dev/null 2>&1; json_bool $?)
fp_configured=false
if [[ -f /etc/pam.d/omarchy-lock-fingerprint ]] && command -v fprintd-list >/dev/null 2>&1; then
  fprintd-list "$USER" 2>/dev/null | grep -qi finger && fp_configured=true
fi

# --- other factors ---------------------------------------------------------
fido2=$(pacman -Qq pam-u2f >/dev/null 2>&1; json_bool $?)
sshd_enabled=$(systemctl is-enabled --quiet sshd 2>/dev/null; json_bool $?)
sshd_running=$(systemctl is-active --quiet sshd 2>/dev/null; json_bool $?)

# --- faillock --------------------------------------------------------------
# A user may read their own tally without privileges. A non-zero count with a
# recent timestamp is the single most useful thing on this panel: it is what
# "my password suddenly stopped working" actually looks like.
fail_count=0
if command -v faillock >/dev/null 2>&1; then
  # `grep -c` prints its count AND exits non-zero when that count is zero, so
  # `|| echo 0` appends a second zero and the JSON stops parsing. `|| true`
  # swallows the status without adding output.
  fail_count=$(faillock --user "$USER" 2>/dev/null | grep -cE '^[0-9]{4}-' || true)
fi

# --- idle and lock ---------------------------------------------------------
idle_json=$(python3 -c '
import json, os, sys

paths = [
    os.path.expanduser("~/.config/omarchy/shell.json"),
    "/usr/share/omarchy/config/omarchy/shell.json",
]
for path in paths:
    try:
        idle = json.load(open(path)).get("idle") or {}
    except Exception:
        continue
    if idle:
        print(json.dumps({
            "screensaver": idle.get("screensaver"),
            "lock": idle.get("lock"),
        }))
        sys.exit(0)
print(json.dumps({"screensaver": None, "lock": None}))
' 2>/dev/null || echo '{"screensaver":null,"lock":null}')

# --- sudo ------------------------------------------------------------------
sudo_passwordless=false
if [[ -r /etc/sudoers.d ]] && grep -rqs "NOPASSWD" /etc/sudoers.d/ 2>/dev/null; then
  sudo_passwordless=true
fi

out=$(cat <<JSON
{
  "face": {
    "hardware": $face_hardware,
    "engine": "$face_engine",
    "installed": $face_installed,
    "disabled": $face_disabled,
    "models": $face_models,
    "sudo": $face_sudo,
    "polkit": $face_polkit
  },
  "fingerprint": { "hardware": $fp_hardware, "configured": $fp_configured },
  "fido2": { "installed": $fido2 },
  "sshd": { "enabled": $sshd_enabled, "running": $sshd_running },
  "faillock": { "failures": ${fail_count:-0} },
  "idle": $idle_json,
  "sudo": { "passwordless": $sudo_passwordless }
}
JSON
)

if [[ ${1:-} == --pretty ]]; then
  printf '%s\n' "$out" | python3 -m json.tool
else
  printf '%s\n' "$out" | tr -d '\n ' 
  echo
fi
