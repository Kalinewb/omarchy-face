#!/bin/bash

# Stub engine: the write half (plan-merged.md §2.3), which writes nothing.
#
# With $OMARCHY_FACE_DEV_BIN set the GUI drops pkexec (plan-gui.md §2.1), so
# this runs as the user and could not touch root-owned state even if it tried.
# Every verb answers in the contract's shape; the ones the GUI cannot yet drive
# say so rather than pretending to have succeeded.

set -uo pipefail

HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
STANDIN_UNIT=omarchy-face-dev-build

# The engine build, as far as the GUI can tell (plan-engine.md §5.2). The real
# job is a transient ROOT unit; this is a transient unit of the user manager
# running dev/bin/omarchy-face-build-standin, which walks the same step list
# into $OMARCHY_FACE_DEV_STATE/install.json. Same shape, same detachment, no
# compiler: closing the popup or restarting the shell does not touch it, which
# is the half of phase 3's gate that belongs to the GUI.
#
#   OMARCHY_FACE_DEV_BUILD_SECONDS   seconds per step (default 8)
#   OMARCHY_FACE_DEV_BUILD_FAIL      "build:dlib_build_failed" to fail there
start_standin() {
  local state=${OMARCHY_FACE_DEV_STATE:-}
  [[ -n $state ]] || return 0
  if systemctl --user is-active --quiet "$STANDIN_UNIT.service" 2>/dev/null; then
    return 3
  fi
  systemctl --user reset-failed "$STANDIN_UNIT.service" >/dev/null 2>&1
  systemd-run --user --unit="$STANDIN_UNIT" --collect --quiet --property=Type=exec \
    "$HERE/omarchy-face-build-standin" "$state" \
    "${OMARCHY_FACE_DEV_BUILD_SECONDS:-8}" "${OMARCHY_FACE_DEV_BUILD_FAIL:-}" >/dev/null 2>&1
}

verb=${1:-}
shift || true

case "$verb" in
  set-label | set-permission | remove-appearance | remove-person | \
  sudo-on | sudo-off | lock-on | lock-off | regenerate | purge-legacy)
    # Drain stdin: the real verbs take their labels there (§2 rule 4), and a
    # GUI that writes to a helper which never reads gets EPIPE instead of a
    # result.
    cat >/dev/null
    printf '{"ok":true,"verb":"%s","dev":true}\n' "$verb"
    exit 0
    ;;
  install-system)
    # The first install ends by starting the build (plan-engine.md §5.1), and
    # Setup's first-install Fix lands here in development.
    cat >/dev/null
    started=false
    start_standin && started=true
    printf '{"ok":true,"verb":"install-system","started":%s,"dev":true}\n' "$started"
    exit 0
    ;;
  install-engine)
    start_standin
    # Exit 3 is "a build is already running" (plan-merged.md §2 rule 3), and the
    # Setup view's "The engine is already building" depends on getting it.
    [[ $? == 3 ]] && { printf '{"error":"install_running","dev":true}\n'; exit 3; }
    printf '{"started":true,"dev":true}\n'
    exit 0
    ;;
  purge)
    systemctl --user stop "$STANDIN_UNIT.service" >/dev/null 2>&1
    [[ -n ${OMARCHY_FACE_DEV_STATE:-} ]] &&
      rm -f "$OMARCHY_FACE_DEV_STATE/install.json" "$OMARCHY_FACE_DEV_STATE/install.log"
    printf '{"ok":true,"incomplete":[],"dev":true}\n'
    exit 0
    ;;
  enroll-session)
    # A scripted session (plan-merged.md §2.4), for driving the recording card
    # without an engine, a camera or a password dialog. It writes nothing
    # anywhere: `done` answers `saved` out of the fixture's own people.json, and
    # every other path answers and exits.
    #
    #   OMARCHY_FACE_DEV_READY_DELAY   seconds before `ready` -- the stand-in for
    #                                  a slow polkit dialog, which is what phase
    #                                  4's gate is about
    #   OMARCHY_FACE_DEV_CAPTURE       ok (default) | weak | <capture_failed code>
    #   OMARCHY_FACE_DEV_SESSION_ERROR a session-fatal code, sent before ready
    name=${1:-}
    # A transcript beside the fixture, because the one thing a test cannot see
    # from the outside is whether the session ENDED by stdin closing (discarded,
    # exit 0) or by being killed -- which is the difference between the cancel
    # the contract describes and a signal that cannot reach a root process.
    session_log() {
      [[ -n ${OMARCHY_FACE_DEV_STATE:-} ]] || return 0
      printf '%s\n' "$*" >>"$OMARCHY_FACE_DEV_STATE/session.log"
    }
    trap 'session_log killed; exit 143' TERM INT HUP
    session_log "start $name"
    if [[ -n ${OMARCHY_FACE_DEV_SESSION_ERROR:-} ]]; then
      printf '{"event":"error","error":"%s"}\n' "$OMARCHY_FACE_DEV_SESSION_ERROR"
      exit 1
    fi
    sleep "${OMARCHY_FACE_DEV_READY_DELAY:-0}"
    session_log ready
    printf '{"event":"ready","person":null}\n'
    captures=0
    while IFS= read -r line; do
      case $line in
        *'"cmd":"create"'*) ;;
        *'"cmd":"capture"'*)
          appearance=$(sed -n 's/.*"appearance":"\([^"]*\)".*/\1/p' <<<"$line")
          printf '{"event":"capturing"}\n'
          sleep 0.2
          case ${OMARCHY_FACE_DEV_CAPTURE:-ok} in
            ok)
              captures=$((captures + 1))
              printf '{"event":"captured","appearance":"%s","certainty":0.28,"threshold":0.35,"weak":false}\n' "$appearance" ;;
            weak)
              captures=$((captures + 1))
              printf '{"event":"captured","appearance":"%s","certainty":0.33,"threshold":0.35,"weak":true}\n' "$appearance" ;;
            *)
              printf '{"event":"capture_failed","code":"%s"}\n' "${OMARCHY_FACE_DEV_CAPTURE}" ;;
          esac
          ;;
        *'"cmd":"done"'*)
          session_log "done captures=$captures"
          printf '{"event":"saved","person":{"name":"%s","label":"%s","owner":false,"sudo":false,"lock":false,"appearances":[]}}\n' \
            "$name" "$name"
          exit 0
          ;;
      esac
    done
    # stdin closed before `done`: the cancel, and nothing was written (§2.4).
    session_log discarded
    printf '{"event":"discarded"}\n'
    exit 0
    ;;
  *)
    printf '{"error":"unknown_verb","verb":"%s"}\n' "$verb"
    exit 1
    ;;
esac
