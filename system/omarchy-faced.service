# omarchy-face v2
# omarchy-face-version: 2.0.0
#
# Socket-activated, idle-exiting, and allowed to do exactly two things: open the
# infrared camera and read the face models (plan-engine.md §6).

[Unit]
Description=Face verification for callers that cannot hold privilege
Documentation=https://github.com/Kalinewb/omarchy-face
Requires=omarchy-faced.socket
After=omarchy-faced.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/omarchy-faced
# Socket activated and idle-exiting, so this is not a root process sitting
# around all day waiting to be interesting to somebody.
Restart=no

# It reads root-owned models and opens the IR sensor. Both are owner-match, not
# CAP_DAC_OVERRIDE -- except that /usr/lib/security/howdy is mode 600 with no
# execute bit, so traversing into it needs CAP_DAC_READ_SEARCH and nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictSUIDSGID=yes
ProtectProc=invisible
DevicePolicy=closed
DeviceAllow=char-video4linux rw
ProtectSystem=strict
ReadWritePaths=/run/omarchy-face
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
# Everything this process writes is root-only by construction; state.json is the
# one exception and it is chmod'd 0644 explicitly, because the GUI that draws it
# runs as the owner.
UMask=0077

# The filter the stub deliberately did not carry, now that there is code to test
# it against. @system-service covers what the daemon actually does: accept on a
# unix socket, flock, fork and exec `timeout python3 compare.py`, kill its
# process group, rename a file. Anything outside that set is a daemon doing
# something this file was not written to do.
SystemCallFilter=@system-service
# EPERM rather than the default SIGSYS kill, and that is a considered choice:
# a killed daemon is an exit path that did not drain the socket, which is the
# one failure this unit must never have -- systemd would re-activate it for the
# connection still pending, hit the start-rate limit, and put the SOCKET into
# `failed` (see omarchy-faced's header). An EPERM comes back as an OSError, the
# request answers `NO error`, and the next one still works.
SystemCallErrorNumber=EPERM
# The cost of EPERM is that a violation is quiet -- a request answers `NO error`
# and nothing says why. This logs every call outside the set, so the journal
# names it without the filter having to kill anything to be noticed.
SystemCallLog=~@system-service

# No [Install] section on purpose. This service exists to be started BY the
# socket; `systemctl enable omarchy-faced.service` would make it a root process
# started at boot and kept alive outside the socket-activation model -- which is
# the one shape §6 says it must never have. The socket unit is the only thing
# that is enabled.
