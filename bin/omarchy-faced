#!/usr/bin/env python3
"""Answer face-verification requests for callers that cannot hold privilege.

The lock screen is an ordinary user process calling PAM directly. There is no
privilege for pam_exec's seteuid to elevate to, so a helper launched from that
stack runs as the user and cannot read the root-owned face models. That is not
a bug to fix in the helper; it is the reason every other biometric PAM
integration has a privileged component. pam_unix shells out to setuid
unix_chkpwd, pam_fprintd talks to fprintd. This is that component.

What it will not do is as important as what it will:

  * it answers yes or no, and never returns a model, an encoding, or a score
  * it answers only about the caller's own account, decided from the kernel's
    peer credentials rather than from anything the caller says
  * it runs one check at a time and rate limits them, because each one turns
    on an infrared emitter pointed at whoever is sitting there

It is socket activated, so it is not a root process sitting around all day.
"""

import os
import pwd
import re
import select
import socket
import struct
import subprocess
import sys
import time

SOCKET_PATH = "/run/omarchy-face/verify.sock"
IDENTITY_PREFIX = "identity-"
MODELS_DIR = "/usr/lib/security/howdy/models"
ENGINE_CONFIG = "/etc/omarchy-face/config"
IDLE_EXIT_SECONDS = 120
MIN_INTERVAL_SECONDS = 2.0
DEFAULT_TIMEOUT = 10
MAX_TIMEOUT = 30
USERNAME = re.compile(r"^[a-z_][a-z0-9_-]*\$?$")
IDENTITY = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")

last_check = {}


def log(message):
    print(message, file=sys.stderr, flush=True)


def engine_path():
    engine = "howdy"
    try:
        with open(ENGINE_CONFIG) as handle:
            for line in handle:
                key, _, value = line.partition("=")
                if key.strip() == "engine":
                    value = value.split("#", 1)[0].strip()
                    if re.fullmatch(r"[a-z0-9][a-z0-9-]*", value):
                        engine = value
    except OSError:
        pass
    path = "/usr/local/bin/omarchy-face-engine-%s" % engine
    return path if os.access(path, os.X_OK) else None


def notify(state, detail=""):
    """Best effort: the indicator is never allowed to affect the answer."""
    try:
        subprocess.run(
            ["/usr/local/bin/omarchy-face-notify", state, detail],
            timeout=5,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def verify(user, timeout, connection=None, service=""):
    engine = engine_path()
    if engine is None:
        return False, "no-engine"

    if os.path.exists("/etc/omarchy-face/disabled"):
        return False, "disabled"

    environment = dict(os.environ, OMARCHY_FACE_TIMEOUT=str(timeout), PAM_USER=user)
    quiet = not user.startswith(IDENTITY_PREFIX)
    if quiet:
        notify("start", service or "daemon")

    process = subprocess.Popen(
        [engine, "verify", user],
        env=environment,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    # Watch the client while the engine works. A caller that hangs up has
    # stopped caring, and the only polite response is to put the camera down.
    deadline = time.monotonic() + timeout + 10
    while process.poll() is None:
        if time.monotonic() > deadline:
            process.kill()
            process.wait(timeout=5)
            if quiet:
                notify("failed", "timeout")
            return False, "timeout"
        if connection is not None:
            readable, _, _ = select.select([connection], [], [], 0.25)
            if readable:
                try:
                    if connection.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT) == b"":
                        process.kill()
                        process.wait(timeout=5)
                        log("client hung up; camera released")
                        return False, "cancelled"
                except BlockingIOError:
                    pass
                except OSError:
                    pass
        else:
            time.sleep(0.25)

    if process.returncode == 0:
        if quiet:
            notify("matched", service or "daemon")
        return True, "matched"

    if quiet:
        notify("failed", str(process.returncode))
    return False, "exit-%d" % process.returncode


def caller_is_remote(pid):
    """Same predicate the gate uses, so remote callers meet one policy."""
    try:
        with open("/proc/%d/cgroup" % pid) as handle:
            match = re.search(r"session-(\d+)\.scope", handle.read())
        if not match:
            return False
        with open("/run/systemd/sessions/%s" % match.group(1)) as handle:
            return "REMOTE=1" in handle.read().split()
    except OSError:
        return False


def peer_identity(connection):
    raw = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    pid, uid, _ = struct.unpack("3i", raw)
    return pid, uid


def handle(connection):
    connection.settimeout(2)
    try:
        request = connection.recv(256).decode("utf-8", "replace").strip()
    except OSError:
        return

    parts = request.split()

    # Listing names is not sensitive and needs no camera, so it is answered
    # before any of the policy below. A UI cannot offer a choice it cannot see.
    if parts[:1] == ["LIST-IDENTITIES"]:
        try:
            names = sorted(
                entry[len(IDENTITY_PREFIX):-4]
                for entry in os.listdir(MODELS_DIR)
                if entry.startswith(IDENTITY_PREFIX) and entry.endswith(".dat")
            )
        except OSError:
            names = []
        connection.sendall("".join("NAME %s\n" % name for name in names).encode() or b"\n")
        return

    if len(parts) < 2 or parts[0] not in ("VERIFY", "VERIFY-IDENTITY"):
        connection.sendall(b"NO bad-request\n")
        return

    # VERIFY-IDENTITY asks about a named face that is not an account: a
    # partner, say. It lives here rather than behind its own pkexec helper so
    # there is one rate limit, one session policy and one place that talks to
    # the camera -- and so that nothing runs root with an argv a caller chose.
    identity_mode = parts[0] == "VERIFY-IDENTITY"

    if identity_mode:
        name = parts[1]
        if not IDENTITY.match(name):
            connection.sendall(b"NO bad-identity\n")
            return
        user = IDENTITY_PREFIX + name
        if not os.path.exists(os.path.join(MODELS_DIR, user + ".dat")):
            connection.sendall(b"NO not-enrolled\n")
            return
    else:
        user = parts[1]
        if not USERNAME.match(user):
            connection.sendall(b"NO bad-user\n")
            return

    timeout = DEFAULT_TIMEOUT
    if len(parts) > 2 and parts[2].isdigit():
        timeout = max(1, min(MAX_TIMEOUT, int(parts[2])))

    # Who is asking is decided by the kernel, not by the request. Without this
    # any local account could ask this daemon to unlock a different one.
    pid, uid = peer_identity(connection)
    try:
        caller = pwd.getpwuid(uid).pw_name
    except KeyError:
        connection.sendall(b"NO unknown-caller\n")
        return

    # An identity is not an account, so "your own account" cannot gate it. What
    # gates it is being local: a face in front of this machine says nothing
    # about someone on the far end of a network.
    if not identity_mode and uid != 0 and caller != user:
        log("refused: uid %d asked about %s" % (uid, user))
        connection.sendall(b"NO not-your-account\n")
        return

    if uid != 0 and caller_is_remote(pid):
        log("refused: uid %d asked from a remote session" % uid)
        connection.sendall(b"NO remote-session\n")
        return

    # Each check runs an infrared emitter at whoever is in front of the
    # machine. A caller that can ask freely can both keep it running and use it
    # as a presence oracle, so asks are spaced out.
    now = time.monotonic()
    if now - last_check.get(uid, 0.0) < MIN_INTERVAL_SECONDS:
        connection.sendall(b"NO too-soon\n")
        return
    last_check[uid] = now

    ok, reason = verify(user, timeout, connection=connection,
                        service="identity" if identity_mode else "")
    connection.sendall((b"OK\n" if ok else ("NO %s\n" % reason).encode()))


def listener():
    """Prefer the socket systemd passed in; fall back to making our own."""
    if os.environ.get("LISTEN_FDS") == "1" and int(os.environ.get("LISTEN_PID", 0)) == os.getpid():
        return socket.socket(fileno=3, family=socket.AF_UNIX, type=socket.SOCK_STREAM), False

    os.makedirs(os.path.dirname(SOCKET_PATH), mode=0o755, exist_ok=True)
    if os.path.exists(SOCKET_PATH):
        os.unlink(SOCKET_PATH)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET_PATH)
    # The socket is reachable by anyone; the peer-credential check above is what
    # actually decides. File permissions cannot express "your own account only".
    os.chmod(SOCKET_PATH, 0o666)
    server.listen(8)
    return server, True


def main():
    if os.geteuid() != 0:
        log("omarchy-faced must run as root")
        return 1

    server, owned = listener()
    server.settimeout(IDLE_EXIT_SECONDS)
    log("omarchy-faced ready")

    try:
        while True:
            try:
                connection, _ = server.accept()
            except socket.timeout:
                # Socket activation will start us again on the next request.
                log("idle, exiting")
                return 0
            with connection:
                try:
                    handle(connection)
                except Exception as error:
                    log("error: %s" % error)
                    try:
                        connection.sendall(b"NO internal-error\n")
                    except OSError:
                        pass
    finally:
        if owned:
            try:
                os.unlink(SOCKET_PATH)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main())
