#!/bin/bash

# omarchy:summary=Privileged face operations for the setup UI, invoked via pkexec
# omarchy:args=<enroll|check|list> <user> [label]
# omarchy:hidden=true

# The setup panel runs as the user and cannot read the face models, which are
# root-owned mode 600 and must stay that way. This is the only thing it is
# allowed to ask root to do, and polkit decides whether it may.
#
# pkexec hands this an argv the caller chose, running as root. Every argument is
# therefore treated as hostile until checked, and the caller is not permitted to
# name a user other than themselves.

set -uo pipefail
export PATH=/usr/local/bin:/usr/bin
unset IFS BASH_ENV ENV CDPATH
umask 077

CONFIG_FILE=/etc/omarchy-face/config
# The enrolled-model summary is state about the machine, not about this boot,
# so it does not belong in /run. Kept there it vanished on reboot and every UI
# that reads it reported "nothing enrolled" while the models sat on disk --
# which looks exactly like face unlock having broken itself overnight.
SUMMARY_DIR=/var/lib/omarchy-face

# Every change to what can open this account, in the journal, with who asked.
# This is the tamper-evidence that is actually worth having: hashing templates
# proves nothing against the only party who can rewrite them.
audit() {
  logger -t omarchy-face -p auth.notice -- "$*" 2>/dev/null || true
}

die_json() {
  printf '{"ok":false,"error":"%s"}\n' "${1//\"/}"
  exit 1
}

config_get() {
  local key=$1 default=${2:-} value
  [[ -r $CONFIG_FILE ]] || {
    printf '%s\n' "$default"
    return
  }
  value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$CONFIG_FILE" 2>/dev/null | tail -1)
  value=${value%%#*}
  value=${value%"${value##*[![:space:]]}"}
  [[ -n $value ]] || value=$default
  printf '%s\n' "$value"
}

engine_cmd() {
  local engine
  engine=$(config_get engine howdy)
  [[ $engine =~ ^[a-z0-9][a-z0-9-]*$ ]] || die_json "invalid engine name"
  [[ -x /usr/local/bin/omarchy-face-engine-$engine ]] || die_json "no adapter for engine $engine"
  printf '/usr/local/bin/omarchy-face-engine-%s\n' "$engine"
}

PREFIX=identity-

valid_identity() {
  [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]
}

action=${1:-}

# Identity actions name a face, not an account, and are authorised as the owner
# rather than as the person being enrolled -- deciding who may open something is
# the machine owner's call, and the other person cannot authenticate as them.
case $action in
  enroll-identity | forget-identity)
    identity=${2:-}
    label=${3:-}
    valid_identity "$identity" || die_json "invalid identity name"

    # Namespacing has to hold in both directions. identity-<name> cannot shadow
    # an account, but an account literally called identity-partner would make
    # that file its PAM model, so the name is refused if such an account exists.
    getent passwd "$PREFIX$identity" >/dev/null 2>&1 &&
      die_json "an account named $PREFIX$identity exists; pick another name"

    if [[ -n ${PKEXEC_UID:-} ]]; then
      id -un -- "$PKEXEC_UID" >/dev/null 2>&1 || die_json "unknown caller"
    fi

    # Namespaced on disk so an identity can never be named in a way that
    # overwrites the model store PAM authenticates a real account against.
    target=$PREFIX$identity
    ENGINE=$(engine_cmd)

    if [[ $action == forget-identity ]]; then
      audit "removing identity '$identity' by uid ${PKEXEC_UID:-0}"
      if "$ENGINE" clear "$target" >/dev/null 2>&1; then
        printf '{"ok":true,"identity":"%s"}\n' "${identity//\"/}"
      else
        printf '{"ok":false,"error":"could not clear identity"}\n'
      fi
      exit 0
    fi

    [[ -n $label ]] || label="Model"
    [[ ${#label} -le 24 ]] || die_json "label too long"
    [[ $label =~ ^[A-Za-z0-9\ _-]+$ ]] || die_json "invalid label"

    if out=$("$ENGINE" enroll "$target" "$label" 2>&1); then
      printf '{"ok":true,"identity":"%s","label":"%s"}\n' "${identity//\"/}" "${label//\"/}"
    else
      printf '{"ok":false,"error":"%s"}\n' "$(printf '%s' "$out" | tr '\n' ' ' | sed 's/"/\\"/g' | tail -c 400)"
    fi
    exit 0
    ;;
esac

user=${2:-}
label=${3:-}

[[ -n $action ]] || die_json "no action given"
[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die_json "invalid user"
id -u -- "$user" >/dev/null 2>&1 || die_json "unknown user"
[[ $user != root ]] || die_json "refusing to manage face models for root"

# The whole point of a privileged helper is that it does not become a way to do
# more than the caller could. pkexec reports who asked; enrolling a face for
# somebody else's account would be handing out a key to it.
if [[ -n ${PKEXEC_UID:-} ]]; then
  caller=$(id -un -- "$PKEXEC_UID" 2>/dev/null) || die_json "unknown caller"
  [[ $caller == "$user" ]] || die_json "callers may only manage their own face models"
fi

ENGINE=$(engine_cmd)

# Labels and timestamps only -- never the encodings, which are biometric
# material and stay in the root-owned store. Published so a UI can show what is
# enrolled without asking the user to authenticate just to read a list.
publish_summary() {
  local summary
  summary=$("$ENGINE" list-json "$user" 2>/dev/null) || return 0
  mkdir -p "$SUMMARY_DIR" 2>/dev/null
  chmod 0755 "$SUMMARY_DIR" 2>/dev/null
  printf '%s\n' "$summary" >"$SUMMARY_DIR/models.json" 2>/dev/null
  chmod 0644 "$SUMMARY_DIR/models.json" 2>/dev/null
}

trap publish_summary EXIT

case $action in
  enroll)
    # howdy caps labels at 24 characters and stores them verbatim in JSON.
    [[ -n $label ]] || label="Model"
    [[ ${#label} -le 24 ]] || die_json "label too long"
    [[ $label =~ ^[A-Za-z0-9\ _-]+$ ]] || die_json "label may only contain letters, digits, spaces, dashes and underscores"

    # A pause the caller can count down against, so authorisation happens
    # before "hold still" rather than after it -- without needing a second
    # prompt or a kept authorisation to bridge the two.
    if [[ ${4:-} =~ ^[0-9]+$ ]] && (( $4 > 0 && $4 <= 10 )); then
      sleep "$4"
    fi

    # A label names a state -- bare, everyday glasses, reading glasses -- so
    # recording one again means "this is what that state looks like now", not
    # "here is a second opinion". Without this the list only ever grows, every
    # retry of a bad capture leaves the bad one behind, and howdy slows down:
    # it compares against every model on every frame.
    replaced=0
    while read -r old_id; do
      [[ $old_id =~ ^[0-9]+$ ]] || continue
      "$ENGINE" remove "$user" "$old_id" >/dev/null 2>&1 && replaced=$((replaced + 1))
    done < <("$ENGINE" list-json "$user" 2>/dev/null | python3 -c '
import json, sys
try:
    models = json.load(sys.stdin).get("models", [])
except Exception:
    sys.exit(0)
wanted = sys.argv[1]
# Highest id first: removing renumbers what follows it.
for model in sorted(models, key=lambda m: m.get("id", 0), reverse=True):
    if model.get("label", "") == wanted:
        print(model.get("id"))
' "$label")

    if out=$("$ENGINE" enroll "$user" "$label" 2>&1); then
      audit "enrolled '$label' for $user (replaced $replaced) by uid ${PKEXEC_UID:-0}"

      # Verify in the same privileged call. Enrolment and the check that proves
      # it works are one decision, and splitting them across two prompts is
      # what made a keep window look necessary.
      threshold=$("$ENGINE" threshold 2>/dev/null || echo "")
      report=$("$ENGINE" verify-report "$user" 2>&1)
      status=$?
      certainty=$(printf '%s' "$report" | sed -n 's/.*Certainty of winning frame:[[:space:]]*\([0-9.]*\).*/\1/p' | tail -1)

      # Wiring PAM is the last step of setting this up, and it belongs here
      # rather than in the installer: the rule worth keeping is that PAM is
      # only ever pointed at face authentication once a model exists AND has
      # been shown to match. That is exactly what just happened, and it is not
      # knowable any earlier. A failed enrolment therefore leaves the auth
      # stacks untouched, which is the same guarantee the terminal setup gave.
      wired=false
      if [[ $status -eq 0 ]] && ! grep -q omarchy-face-verify /etc/pam.d/sudo 2>/dev/null; then
        if omarchy-setup-security-face --pam-only >/dev/null 2>&1; then
          wired=true
          audit "wired face authentication into sudo and polkit for $user"
        fi
      fi

      printf '{"ok":true,"label":"%s","replaced":%d,"verified":%s,"certainty":%s,"threshold":%s,"wired":%s}\n' \
        "${label//\"/}" "$replaced" \
        "$([[ $status -eq 0 ]] && echo true || echo false)" \
        "${certainty:-null}" "${threshold:-null}" "$wired"
    else
      # howdy's failure text is the useful part: too dark, no face found, and
      # so on. Flattened to one line so the caller can parse this as JSON.
      printf '{"ok":false,"error":"%s"}\n' "$(printf '%s' "$out" | tr '\n' ' ' | sed 's/"/\\"/g' | tail -c 400)"
    fi
    ;;

  check)
    # A verification straight after enrolment is the only honest measure of
    # whether the model is any good. howdy reports the winning frame's
    # certainty; lower is a better match, and it must beat the threshold.
    threshold=$("$ENGINE" threshold 2>/dev/null || echo "")
    start=$EPOCHREALTIME
    out=$("$ENGINE" verify-report "$user" 2>&1)
    status=$?
    elapsed=$(awk -v a="$start" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.1f", b - a }')
    certainty=$(printf '%s' "$out" | sed -n 's/.*Certainty of winning frame:[[:space:]]*\([0-9.]*\).*/\1/p' | tail -1)

    printf '{"ok":%s,"exit":%d,"certainty":%s,"threshold":%s,"elapsed":%s}\n' \
      "$([[ $status -eq 0 ]] && echo true || echo false)" \
      "$status" \
      "${certainty:-null}" \
      "${threshold:-null}" \
      "${elapsed:-null}"
    ;;

  list)
    "$ENGINE" list-json "$user" 2>/dev/null || die_json "could not read models"
    ;;

  install-engine)
    # The engine build, behind the same prompt as everything else privileged
    # here, so the panel can run it without opening a terminal. It compiles a
    # package and takes minutes; the caller is expected to show that it is
    # working rather than freeze.
    audit "installing the face engine, requested by uid ${PKEXEC_UID:-0}"

    if ! out=$("$ENGINE" install 2>&1); then
      printf '{"ok":false,"error":"%s"}\n' \
        "$(printf '%s' "$out" | tr '\n' ' ' | sed 's/"/\\"/g' | tail -c 400)"
      exit 0
    fi

    # Point it at the camera in the same call: an engine installed but aimed at
    # nothing is a state with no honest name.
    if describe=$(omarchy-hw-ir-camera --describe 2>/dev/null); then
      IFS=$'\t' read -r _ _ path size <<<"$describe"
      "$ENGINE" configure "$path" "$size" >/dev/null 2>&1 || true
    fi

    printf '{"ok":true}\n'
    ;;

  reset-faillock)
    # A tripped faillock is what "my password suddenly stopped working" is,
    # and clearing it is exactly as sensitive as any other change here, so it
    # sits behind the same prompt.
    if command -v faillock >/dev/null 2>&1 && faillock --user "$user" --reset >/dev/null 2>&1; then
      printf '{"ok":true}\n'
    else
      printf '{"ok":false,"error":"could not reset the failure count"}\n'
    fi
    ;;

  forget)
    # `label` carries the model id here. Deleting a face model is as much the
    # owner's decision as adding one, so it sits behind the same prompt rather
    # than the no-auth verifier.
    [[ $label =~ ^[0-9]+$ ]] || die_json "invalid model id"
    audit "removing model $label for $user by uid ${PKEXEC_UID:-0}"
    if "$ENGINE" remove "$user" "$label" >/dev/null 2>&1; then
      printf '{"ok":true,"removed":%s}\n' "$label"
    else
      printf '{"ok":false,"error":"could not remove model %s"}\n' "$label"
    fi
    ;;

  *)
    die_json "unknown action"
    ;;
esac
