#!/bin/bash

# omarchy:summary=Remove face authentication from sudo and polkit
# omarchy:args=[--keep-engine] [--keep-models]
# omarchy:requires-sudo=true

set -e

GREEN=$'\e[32m'
DIM=$'\e[2m'
RESET=$'\e[0m'

CONFIG_DIR=/etc/omarchy-face
KEEP_ENGINE=false
KEEP_MODELS=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --keep-engine) KEEP_ENGINE=true ;;
    --keep-models) KEEP_MODELS=true ;;
    *)
      echo "Usage: omarchy-remove-security-face [--keep-engine] [--keep-models]" >&2
      exit 2
      ;;
  esac
  shift
done

remove_pam_config() {
  local file

  for file in /etc/pam.d/sudo /etc/pam.d/polkit-1; do
    [[ -f $file ]] || continue
    if grep -qE 'omarchy-face-gate|omarchy-face-verify' "$file"; then
      echo "Removing face authentication from ${file##*/}..."
      sudo sed -i -e '/omarchy-face-gate/d' -e '/omarchy-face-verify/d' "$file"
    fi
  done
}

echo -e "${GREEN}Removing face authentication.\n${RESET}"

# PAM first: whatever else fails below, the authentication stacks must not be
# left pointing at helpers that are on their way out.
remove_pam_config

if [[ $KEEP_MODELS == false ]]; then
  ENGINE=$(omarchy-face engine 2>/dev/null || echo howdy)
  if command -v "omarchy-face-engine-$ENGINE" >/dev/null 2>&1; then
    echo "Clearing enrolled face models..."
    "omarchy-face-engine-$ENGINE" clear "$USER" || true
  fi
fi

if [[ $KEEP_ENGINE == false ]]; then
  ENGINE=$(omarchy-face engine 2>/dev/null || echo howdy)
  if command -v "omarchy-face-engine-$ENGINE" >/dev/null 2>&1; then
    echo "Removing engine packages..."
    "omarchy-face-engine-$ENGINE" uninstall || true
  fi
fi

sudo rm -rf "$CONFIG_DIR" /run/omarchy-face

echo -e "${GREEN}\nFace authentication has been removed.${RESET}"
echo "${DIM}The helper scripts are still in /usr/local/bin; ./uninstall.sh takes those out.${RESET}"
