#!/bin/bash

# omarchy:summary=Returns true when an infrared (IR) camera is present
# omarchy:args=[--node|--path|--describe]
# omarchy:hidden=true

# Twin of omarchy-hw-fingerprint, and deliberately the same shape: a silent
# predicate that answers from sysfs alone, so it still works before v4l-utils
# is installed (the face setup pulls that in). v4l2-ctl, when present, is used
# only to identify sensors whose name gives nothing away.

set -u

SYSFS=${OMARCHY_V4L_SYSFS_PATH:-/sys/class/video4linux}

usage() {
  cat <<USAGE
Usage: omarchy-hw-ir-camera [--node|--path|--preview|--describe]

  (no args)    Exit 0 when an IR camera is present, 1 when not. Prints nothing.
  --node       Print the capture node, e.g. /dev/video2
  --path       Print a path that survives a reboot, e.g. /dev/v4l/by-path/...
  --describe   Print name, node, stable path and frame size, tab separated
  --preview    Print the ORDINARY camera's node -- the one a UI should show
USAGE
}

# An IR sensor names itself one of a handful of ways. Match on word boundaries:
# "Air Camera" contains the letters but is not one; "HP IR Camera" is.
name_looks_ir() {
  local name=${1,,}
  [[ $name =~ (^|[^[:alnum:]])(ir|infra-?red)([^[:alnum:]]|$) ]]
}

# UVC exposes each interface twice: index 0 is the capture node and index 1 the
# metadata node, both carrying the same name. Only the first can be recorded,
# and picking the wrong one hands the engine a device that never yields a frame.
is_capture_node() {
  local idx
  [[ -r $1/index ]] || return 0
  idx=$(<"$1/index")
  [[ $idx == 0 ]]
}

# An IR sensor offers 8-bit greyscale and nothing else; a colour webcam always
# offers YUYV or MJPG. This is the only signal that does not depend on the
# vendor having named the device honestly -- plenty of laptops call both
# sensors "Integrated Camera" and leave you to work it out.
formats_look_ir() {
  local node=$1 formats
  command -v v4l2-ctl >/dev/null 2>&1 || return 1
  formats=$(v4l2-ctl -d "$node" --list-formats-ext 2>/dev/null) || return 1
  [[ $formats == *"'GREY'"* || $formats == *"'Y8 '"* ]] || return 1
  [[ $formats != *"'YUYV'"* && $formats != *"'MJPG'"* ]]
}

find_ir_node() {
  local dev node

  # Pass 1: the device names itself. Trusted on its own -- a sensor that says
  # IR and also reports a colour format is still the IR one, so the format
  # probe must not get a veto here.
  for dev in "$SYSFS"/video*; do
    [[ -r $dev/name ]] || continue
    node=/dev/${dev##*/}
    [[ -c $node ]] || continue
    is_capture_node "$dev" || continue
    name_looks_ir "$(<"$dev/name")" || continue
    printf '%s\n' "$node"
    return 0
  done

  # Pass 2: the name gives nothing away, so go by what the sensor can produce.
  for dev in "$SYSFS"/video*; do
    node=/dev/${dev##*/}
    [[ -c $node ]] || continue
    is_capture_node "$dev" || continue
    formats_look_ir "$node" || continue
    printf '%s\n' "$node"
    return 0
  done

  return 1
}

# /dev/videoN is assigned in probe order and moves when another camera appears.
# by-path is keyed to the physical port, so it holds across reboots and is what
# gets written into the engine's config. by-id covers only the first interface
# of a multi-interface camera -- on the HP OmniBook that is the colour sensor,
# not the IR one -- so it is a fallback, never the first choice.
stable_path_for() {
  local node=$1 link
  node=$(readlink -f "$node")

  for link in /dev/v4l/by-path/*; do
    [[ -e $link ]] || continue
    # The same port is spelled twice, -usb- and -usbv2-. Keep one.
    [[ $link == *-usbv2-* ]] && continue
    [[ $(readlink -f "$link") == "$node" ]] || continue
    printf '%s\n' "$link"
    return 0
  done

  for link in /dev/v4l/by-id/*; do
    [[ -e $link ]] || continue
    [[ $(readlink -f "$link") == "$node" ]] || continue
    printf '%s\n' "$link"
    return 0
  done

  printf '%s\n' "$node"
}

frame_size_for() {
  local node=$1 size
  command -v v4l2-ctl >/dev/null 2>&1 || return 1
  size=$(v4l2-ctl -d "$node" --list-formats-ext 2>/dev/null |
    sed -n 's/.*Size: Discrete \([0-9]\+x[0-9]\+\).*/\1/p' |
    sort -t x -k1,1n -k2,2n | tail -1)
  [[ -n $size ]] || return 1
  printf '%s\n' "$size"
}

# The camera a person should be shown is not the one doing the authenticating.
# An IR frame is a flat grey mask and looks broken on screen, and more to the
# point the IR sensor can only be streamed by one process at a time -- while the
# engine holds it, a preview cannot have it. A laptop with Windows Hello has a
# second, ordinary camera sitting right next to it on its own V4L2 device, which
# is free the whole time. Measured on this hardware: both stream at once over
# the same USB device without starving each other.
find_preview_node() {
  local ir dev node
  ir=$(find_ir_node 2>/dev/null)

  for dev in "$SYSFS"/video*; do
    [[ -r $dev/name ]] || continue
    node=/dev/${dev##*/}
    [[ -c $node ]] || continue
    [[ $node == "$ir" ]] && continue
    is_capture_node "$dev" || continue
    name_looks_ir "$(<"$dev/name")" && continue
    # A metadata node passes every test above and yields no picture, so require
    # a format the sensor can actually hand to a preview.
    if command -v v4l2-ctl >/dev/null 2>&1; then
      local formats
      formats=$(v4l2-ctl -d "$node" --list-formats-ext 2>/dev/null)
      [[ $formats == *"'YUYV'"* || $formats == *"'MJPG'"* ]] || continue
    fi
    printf '%s\n' "$node"
    return 0
  done

  return 1
}

case ${1:-} in
  "")
    find_ir_node >/dev/null
    ;;
  --node)
    find_ir_node
    ;;
  --preview)
    find_preview_node
    ;;
  --path)
    node=$(find_ir_node) || exit 1
    stable_path_for "$node"
    ;;
  --describe)
    node=$(find_ir_node) || exit 1
    name=$(<"$SYSFS/${node##*/}/name")
    printf '%s\t%s\t%s\t%s\n' \
      "$name" "$node" "$(stable_path_for "$node")" "$(frame_size_for "$node" || echo unknown)"
    ;;
  -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
