#!/bin/bash

# omarchy:summary=Remove face unlock from the lock screen and restore Omarchy's
# omarchy:requires-sudo=true

# Disabling the clone is enough: the registry falls back to the first-party
# lock, which was never modified and stays loadable precisely so it can be put
# back. The clone directory is removed too, so a later re-run starts from
# Omarchy's current lock screen rather than a stale copy of an old one.

set -euo pipefail

GREEN=$'\e[32m'
DIM=$'\e[2m'
RESET=$'\e[0m'

PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
SOURCE_ID=omarchy.lock
PAM_FILE=/etc/pam.d/omarchy-lock-face

SUDO=(sudo)
[[ ! -t 0 && -n ${SUDO_ASKPASS:-} ]] && SUDO=(sudo -A)

echo -e "${GREEN}Removing face unlock from the lock screen.\n${RESET}"

CLONE_ID=""
for manifest in "$PLUGINS_DIR"/*/manifest.json; do
  [[ -f $manifest ]] || continue
  id=$(jq -r --arg s "$SOURCE_ID" \
    'select(.omarchy.clonedFrom == $s) | .id' "$manifest" 2>/dev/null) || continue
  [[ -n $id ]] && CLONE_ID=$id && break
done

if [[ -n $CLONE_ID ]]; then
  echo "Disabling ${CLONE_ID}, so Omarchy's lock screen takes over again..."
  omarchy plugin disable "$CLONE_ID" >/dev/null 2>&1 || true
  rm -rf "${PLUGINS_DIR:?}/$CLONE_ID"
  echo "  removed the clone"
else
  echo "  no clone found; nothing to undo"
fi

"${SUDO[@]}" rm -f "$PAM_FILE"
echo "  removed $PAM_FILE"

omarchy restart shell >/dev/null 2>&1 || true

echo
echo -e "${GREEN}Done.${RESET} ${DIM}The lock screen is Omarchy's own again.${RESET}"
